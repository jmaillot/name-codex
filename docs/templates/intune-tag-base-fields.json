{
  "_template": "intune-tag-base-fields",
  "description": "Shared base for Intune tag family (group-tag AGT, autopilot-profile APT) — identical 3 fields after S4 merge. Keep files and share fields.",
  "fields": [
    {
      "name": "Country",
      "library": "core/country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "DeviceType",
      "library": "intune/autopilot-devicetype",
      "defaultValue": "LAPTOP",
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "library": "intune/autopilot-purpose",
      "defaultValue": "STANDARD",
      "allowCustomValue": true
    }
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Country", "DeviceType", "Purpose"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Purpose"],
    "fixedFirstSegments": ["Country"]
  }
}
