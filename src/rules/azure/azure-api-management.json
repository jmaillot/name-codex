{
  "id": "azure-api-management",
  "category": "Azure",
  "name": "API Management",
  "description": "Azure API Management naming per CAF. Service name is globally unique, 1\u201350 characters, alphanumeric and hyphens, must start with letter, end with letter or number.",
  "pattern": "apim-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/apim-workload",
      "defaultValue": "PLATFORM",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "apim-platform-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "forceLowercase": true,
    "allowedPattern": "^[a-z][a-z0-9-]{0,48}[a-z0-9]$"
  }
}
