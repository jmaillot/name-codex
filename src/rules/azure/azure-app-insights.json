{
  "id": "azure-app-insights",
  "category": "Azure",
  "name": "Application Insights",
  "description": "Azure Application Insights naming per CAF. Component name 4\u201363 characters (workspace-based) lowercase letters, numbers and hyphens, must start with letter. Pattern appi-[Workload]-[Environment].",
  "pattern": "appi-[Workload]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/appi-workload",
      "defaultValue": "CRM",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "appi-crm-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Workload"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,61}[a-z0-9]$"
  }
}
