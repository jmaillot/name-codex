{
  "id": "azure-application-gateway",
  "category": "Azure",
  "name": "Application Gateway",
  "description": "Azure Application Gateway naming per CAF. Application gateway provides application-level routing and load balancing for web traffic.",
  "pattern": "agw-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/agw-workload",
      "defaultValue": "INTERNAL",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "agw-internal-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,78}[a-z0-9]$"
  }
}
