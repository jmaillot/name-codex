{
  "id": "azure-backup-vault",
  "category": "Azure",
  "name": "Backup Vault",
  "description": "Azure Backup Vault naming per CAF (Microsoft Cloud Adoption Framework). The vault provides policy-driven backup for Azure VMs, disks and file shares with soft delete and immutability. The name identifies the vault within its resource group and subscription scope for backup governance.",
  "pattern": "bkv-[Workload]-[Location]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/bvault-workload",
      "defaultValue": "SHARED",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["bkv-shared-frc-prod", "bkv-vm-we-dev"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Location", "Environment"],
    "availableSegments": ["Workload", "Location", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{0,48}[a-z0-9]$"
  }
}
