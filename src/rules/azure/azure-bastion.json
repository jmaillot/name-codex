{
  "id": "azure-bastion",
  "category": "Azure",
  "name": "Bastion Host",
  "description": "Azure Bastion naming per CAF (Microsoft Cloud Adoption Framework). Bastion provides secure RDP and SSH connectivity to virtual machines without exposing a public IP. The name identifies the bastion host within its virtual network and resource group scope.",
  "pattern": "BAS-[Location]-[Environment]",
  "fields": [
    {
      "name": "Location",
      "library": "core/location",
      "defaultValue": "AZ",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["BAS-AZ-PROD", "BAS-AAD-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Location", "Environment"],
    "availableSegments": ["Location", "Environment", "Custom"],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{0,78}[A-Za-z0-9]$"
  }
}
