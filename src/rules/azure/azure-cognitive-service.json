{
  "id": "azure-cognitive-service",
  "category": "Azure",
  "name": "Azure AI Services",
  "description": "Azure AI Services naming per CAF (Microsoft Cloud Adoption Framework). Azure AI Services (formerly Cognitive Services) provide AI APIs for OpenAI, vision, speech, language, search and content safety. The name identifies the AI service account within its resource group and subscription scope for AI workload governance.",
  "pattern": "AIS-[Workload]-[Location]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/cog-workload",
      "defaultValue": "OPENAI",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "library": "core/location",
      "defaultValue": "AZ",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["AIS-OPENAI-AZ-PROD", "AIS-COPILOT-AAD-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Location", "Environment"],
    "availableSegments": ["Workload", "Location", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 64,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{0,62}[A-Za-z0-9]$"
  }
}
