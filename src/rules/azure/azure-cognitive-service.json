{
  "id": "azure-cognitive-service",
  "category": "Azure",
  "name": "Cognitive Service",
  "description": "Azure Cognitive Services (Azure AI Services) naming per CAF (Microsoft Cloud Adoption Framework). Cognitive Services provide AI APIs for vision, speech, language and decision. The name identifies the service account within its resource group and subscription scope for AI workload governance.",
  "pattern": "cog-[Workload]-[Environment]-[Region]-[Instance]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/cog-workload",
      "defaultValue": "SHARED",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": ["cog-shared-prod-frc-001"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Environment", "Region", "Instance"],
    "availableSegments": ["Workload", "Environment", "Region", "Instance", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 64,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
  }
}
