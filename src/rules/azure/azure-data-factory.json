{
  "id": "azure-data-factory",
  "category": "Azure",
  "name": "Data Factory",
  "description": "Azure Data Factory naming per CAF. Factory name 3\u201363 characters, alphanumeric and hyphens, must start with letter.",
  "pattern": "ADF-[Workload]-[Location]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/adf-workload",
      "defaultValue": "DATA",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "library": "core/location",
      "defaultValue": "AZ",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["ADF-DATA-AZ-PROD", "ADF-SYNAPSE-AAD-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Location", "Environment"],
    "availableSegments": ["Workload", "Location", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{1,61}[A-Za-z0-9]$"
  }
}
