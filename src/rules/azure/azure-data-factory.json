{
  "id": "azure-data-factory",
  "category": "Azure",
  "name": "Data Factory",
  "description": "Azure Data Factory naming per CAF. Factory name 3\u201363 characters, alphanumeric and hyphens, must start with letter.",
  "pattern": "adf-[Workload]-[Region]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/adf-workload",
      "defaultValue": "DATA",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["adf-data-frc-prod", "adf-synapse-we-dev"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Region", "Environment"],
    "availableSegments": ["Workload", "Region", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
  }
}
