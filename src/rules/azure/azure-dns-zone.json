{
  "id": "azure-dns-zone",
  "category": "Azure",
  "name": "DNS Zone",
  "description": "Azure Public DNS Zone naming per CAF (Microsoft Cloud Adoption Framework). The public zone hosts authoritative DNS records for an internet-facing domain within Azure DNS. The Azure resource name is the DNS domain itself. This convention applies workload taxonomy plus environment and domain for public zone governance.",
  "pattern": "dnsz-[Workload]-[Environment].[Domain]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/dnsz-workload",
      "defaultValue": "CORP",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Domain",
      "defaultValue": "contoso.com",
      "allowCustomValue": true
    }
  ],
  "examples": ["dnsz-corp-prod.contoso.com", "dnsz-web-dev.example.net"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Environment", "Domain"],
    "availableSegments": ["Workload", "Environment", "Domain", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)(?!-)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
  }
}
