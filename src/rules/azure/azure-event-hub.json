{
  "id": "azure-event-hub",
  "category": "Azure",
  "name": "Event Hub",
  "description": "Azure Event Hub naming per CAF \u2014 Namespace EVHNS-[Purpose]-[Environment] (6\u201350 chars) and Event Hub EVH-[Workload]-[Purpose]-[Environment] (1\u201350 chars), lowercase letters, numbers and hyphens, start letter, no consecutive hyphens.",
  "pattern": "evhns-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/evh-ns-purpose",
      "defaultValue": "INTEGRATION",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "patterns": [
    {
      "id": "namespace",
      "name": "Namespace",
      "description": "Event Hub Namespace. Globally unique, 6\u201350 characters, lowercase, hyphenated. Pattern EVHNS-[Purpose]-[Environment].",
      "pattern": "evhns-[Purpose]-[Environment]",
      "examples": [
        "evhns-integration-prod"
      ]
    },
    {
      "id": "hub",
      "name": "Event Hub",
      "description": "Event Hub entity within a namespace. Pattern EVH-[Workload]-[Purpose]-[Environment].",
      "pattern": "evh-[Workload]-[Purpose]-[Environment]",
      "fields": [
        {
          "name": "Workload",
          "library": "azure/evh-workload",
          "defaultValue": "CRM",
          "allowCustomValue": true
        },
        {
          "name": "Purpose",
          "library": "azure/evh-hub-purpose",
          "defaultValue": "ORDERS",
          "allowCustomValue": true
        },
        {
          "name": "Environment",
          "library": "core/environment",
          "defaultValue": "PROD",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "evh-crm-orders-prod"
      ]
    }
  ],
  "examples": [
    "evhns-integration-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Workload",
      "Purpose",
      "Environment",
      "Custom"
    ],
    "recommendedSegments": [
      "Workload",
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{4,48}[a-z0-9]$"
  }
}
