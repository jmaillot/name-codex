{
  "id": "azure-firewall",
  "category": "Azure",
  "name": "Azure Firewall",
  "description": "Azure Firewall naming per CAF. Name 4\u201380 characters, lowercase letters, numbers and hyphens, must start with letter and end with letter or number, no consecutive hyphens. Pattern afw-[Purpose]-[Environment].",
  "pattern": "afw-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/afw-workload",
      "defaultValue": "HUB",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "afw-hub-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,78}[a-z0-9]$"
  }
}
