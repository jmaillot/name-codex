{
  "id": "azure-kubernetes-service",
  "category": "Azure",
  "name": "Kubernetes Service (AKS)",
  "description": "Azure Kubernetes Service naming per CAF (Microsoft Cloud Adoption Framework). AKS cluster and node pools provide managed Kubernetes for container workloads.",
  "pattern": "aks-[Workload]-[Environment]-[Region]-[Instance]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/aks-workload",
      "defaultValue": "SHARED",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "patterns": [
    {
      "id": "cluster",
      "name": "Cluster",
      "description": "AKS cluster. Cluster name 1\u201363 characters, lowercase letters, numbers and hyphens, must start with letter and end with letter or number, no consecutive hyphens. Represents the managed Kubernetes cluster.",
      "pattern": "aks-[Workload]-[Environment]-[Region]-[Instance]",
      "examples": [
        "aks-shared-prod-frc-001"
      ]
    },
    {
      "id": "nodepool",
      "name": "Node Pool",
      "description": "AKS node pool. Node pool name 1\u201312 characters, lowercase letters and numbers, must start with letter. Role identifies the node pool purpose (system, workload, spot).",
      "pattern": "AKNP-[Role]",
      "fields": [
        {
          "name": "Role",
          "library": "azure/aks-nodepool-role",
          "defaultValue": "SYSTEM",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "AKNP-system"
      ]
    }
  ],
  "examples": [
    "aks-shared-prod-frc-001"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Environment",
      "Region",
      "Instance"
    ],
    "availableSegments": [
      "Workload",
      "Role",
      "Environment",
      "Region",
      "Instance",
      "Custom"
    ],
    "recommendedSegments": [
      "Workload",
      "Role"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
  }
}
