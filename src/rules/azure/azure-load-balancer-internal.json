{
  "id": "azure-load-balancer-internal",
  "category": "Azure",
  "name": "Load Balancer (Internal)",
  "description": "Azure Load Balancer (Internal) naming per CAF. Name 4\u201380 characters, lowercase letters, numbers and hyphens, must start with letter and end with letter or number, no consecutive hyphens. Pattern lbi-[Purpose]-[Environment].",
  "pattern": "lbi-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/lbi-purpose",
      "defaultValue": "AKS",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "lbi-aks-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,78}[a-z0-9]$"
  }
}
