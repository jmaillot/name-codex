{
  "id": "azure-load-balancer",
  "category": "Azure",
  "name": "Load Balancer",
  "description": "Azure Load Balancer naming per CAF (Microsoft Cloud Adoption Framework). Name 4–80 characters, lowercase letters, numbers and hyphens, must start with letter and end with letter or number, no consecutive hyphens. Pattern lb-[Workload]-[Environment]-[Region]-[Instance].",
  "pattern": "lb-[Workload]-[Environment]-[Region]-[Instance]",
  "fields": [
    {
      "name": "Workload",
      "defaultValue": "APP",
      "allowCustomValue": true,
      "values": [
        {
          "value": "WEB",
          "description": "Web tier"
        },
        {
          "value": "APP",
          "description": "Application tier"
        },
        {
          "value": "API",
          "description": "API tier"
        },
        {
          "value": "SHARED",
          "description": "Shared"
        }
      ]
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Environment", "Region", "Instance"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,78}[a-z0-9]$"
  },
  "examples": ["lb-app-prod-frc-001"]
}
