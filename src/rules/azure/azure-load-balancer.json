{
  "id": "azure-load-balancer",
  "category": "Azure",
  "name": "Load Balancer",
  "description": "Azure Load Balancer naming per CAF (Microsoft Cloud Adoption Framework). Load balancers provide high availability and network performance to your applications.",
  "pattern": "lbi-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/lbi-purpose",
      "defaultValue": "AKS",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "patterns": [
    {
      "id": "internal",
      "name": "Internal",
      "description": "Internal load balancer for private traffic within a virtual network. Name 4\u201380 characters, lowercase, hyphenated, internal-facing.",
      "pattern": "lbi-[Purpose]-[Environment]",
      "fields": [
        {
          "name": "Purpose",
          "library": "azure/lbi-purpose",
          "defaultValue": "AKS",
          "allowCustomValue": true
        },
        {
          "name": "Environment",
          "library": "core/environment",
          "defaultValue": "PROD",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "lbi-aks-prod"
      ]
    },
    {
      "id": "external",
      "name": "External",
      "description": "External load balancer for public-facing traffic. Name 4\u201380 characters, lowercase, hyphenated, internet-facing.",
      "pattern": "lbe-[Purpose]-[Environment]",
      "fields": [
        {
          "name": "Purpose",
          "library": "azure/lbe-purpose",
          "defaultValue": "WEB",
          "allowCustomValue": true
        },
        {
          "name": "Environment",
          "library": "core/environment",
          "defaultValue": "PROD",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "lbe-web-prod"
      ]
    }
  ],
  "examples": [
    "lbi-aks-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Purpose",
      "Environment",
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,78}[a-z0-9]$"
  }
}
