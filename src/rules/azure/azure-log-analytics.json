{
  "id": "azure-log-analytics",
  "category": "Azure",
  "name": "Log Analytics Workspace",
  "description": "Azure Log Analytics Workspace naming per CAF (Microsoft Cloud Adoption Framework). Workspace collects and analyzes log data from Azure resources.",
  "pattern": "log-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/log-workload",
      "defaultValue": "MONITORING",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "log-monitoring-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{2,61}[a-z0-9]$"
  }
}
