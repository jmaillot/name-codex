{
  "id": "azure-machine-learning-workspace",
  "category": "Azure",
  "name": "Machine Learning Workspace",
  "description": "Azure Machine Learning Workspace naming per CAF (Microsoft Cloud Adoption Framework). The workspace centralizes model training, inference endpoints and feature stores for machine learning lifecycles. The name identifies the workspace within its resource group and subscription scope for AI governance.",
  "pattern": "mlw-[Workload]-[Region]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/mlw-workload",
      "defaultValue": "SHARED",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["mlw-shared-frc-prod", "mlw-train-we-dev"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Region", "Environment"],
    "availableSegments": ["Workload", "Region", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{0,48}[a-z0-9]$"
  }
}
