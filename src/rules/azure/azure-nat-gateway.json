{
  "id": "azure-nat-gateway",
  "category": "Azure",
  "name": "NAT Gateway",
  "description": "Azure NAT Gateway naming per CAF (Microsoft Cloud Adoption Framework). NAT Gateway provides secure outbound connectivity for resources in a virtual network subnet. The name identifies the gateway associated with its subnet and resource group scope.",
  "pattern": "NGW-[Workload]-[Region]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/ngw-workload",
      "defaultValue": "SHARED",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["NGW-SHARED-FRC-PROD", "NGW-HUB-WE-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Region", "Environment"],
    "availableSegments": ["Workload", "Region", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{0,78}[A-Za-z0-9]$"
  }
}
