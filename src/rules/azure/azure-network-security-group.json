{
  "id": "azure-network-security-group",
  "category": "Azure",
  "name": "Network Security Group",
  "description": "Azure Network Security Group naming per CAF (Microsoft Cloud Adoption Framework — Microsoft's guidance collection for structuring and naming cloud resources).",
  "pattern": "nsg-[Environment]-[Region]-[Workload]-[Instance]",
  "fields": [
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "type": "dropdown",
      "defaultValue": "APP",
      "allowCustomValue": true,
      "values": [
        {
          "value": "WEB",
          "description": "Web tier"
        },
        {
          "value": "APP",
          "description": "Application tier"
        },
        {
          "value": "DB",
          "description": "Database tier"
        },
        {
          "value": "MGMT",
          "description": "Management"
        },
        {
          "value": "VPN",
          "description": "VPN Gateway"
        },
        {
          "value": "DMZ",
          "description": "Demilitarized zone"
        },
        {
          "value": "AKS",
          "description": "Azure Kubernetes Service"
        },
        {
          "value": "PE",
          "description": "Private Endpoint"
        },
        {
          "value": "BASTION",
          "description": "Azure Bastion"
        },
        {
          "value": "SHARED",
          "description": "Shared"
        }
      ]
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "nsg-prod-frc-web-001"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Environment",
      "Region",
      "Workload",
      "Instance"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Workload"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Environment"
    ],
    "fixedLastSegments": []
  },
  "validation": {
    "forceUppercase": true,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
