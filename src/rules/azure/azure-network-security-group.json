{
  "id": "azure-network-security-group",
  "category": "Azure",
  "name": "Network Security Group",
  "description": "Azure Network Security Group naming per CAF (Microsoft Cloud Adoption Framework — Microsoft's guidance collection for structuring and naming cloud resources): nsg-<environment>-<region>-<workload>-<instance>.",
  "pattern": "nsg-[Environment]-[Region]-[Workload]-[Instance]",
  "fields": [
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "type": "dropdown",
      "defaultValue": "APP",
      "allowCustomValue": true,
      "allowedValues": [
        "WEB",
        "APP",
        "DB",
        "MGMT",
        "VPN",
        "DMZ",
        "AKS",
        "PE",
        "BASTION",
        "SHARED"
      ]
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": ["nsg-prod-frc-web-001"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Environment", "Region", "Workload", "Instance"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": ["Environment"],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "forceLowercase": true,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
