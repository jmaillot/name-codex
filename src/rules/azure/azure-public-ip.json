{
  "id": "azure-public-ip",
  "category": "Azure",
  "name": "Public IP",
  "description": "Azure Public IP naming per CAF (Microsoft Cloud Adoption Framework — Microsoft's guidance collection for structuring and naming cloud resources).",
  "pattern": "pip-[Environment]-[Region]-[Workload]-[Instance]",
  "fields": [
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "type": "dropdown",
      "defaultValue": "VM",
      "allowCustomValue": true,
      "library": "azure/publicip-workload"
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "PIP-PROD-FRC-VM-001"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Environment",
      "Region",
      "Workload",
      "Instance"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Workload"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Environment"
    ],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 80,
    "forceUppercase": true,
    "allowedPattern": "^[A-Za-z0-9_.-]{1,80}$"
  }
}
