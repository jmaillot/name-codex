{
  "id": "azure-recovery-vault",
  "category": "Azure",
  "name": "Recovery Services Vault",
  "description": "Azure Recovery Services Vault naming per CAF (Microsoft Cloud Adoption Framework). The vault secures backup and disaster recovery data for virtual machines and workloads. The name identifies the vault within its resource group and subscription scope for protection policies.",
  "pattern": "RSV-[Workload]-[Region]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/rsv-workload",
      "defaultValue": "SHARED",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["RSV-SHARED-FRC-PROD", "RSV-BACKUP-WE-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Region", "Environment"],
    "availableSegments": ["Workload", "Region", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{0,48}[A-Za-z0-9]$"
  }
}
