{
  "id": "azure-redis-cache",
  "category": "Azure",
  "name": "Redis Cache",
  "description": "Azure Redis Cache naming per CAF (Microsoft Cloud Adoption Framework). The Redis cache instance provides in-memory data store for caching and session state. The name refers to the cache instance itself and must be globally unique where applicable.",
  "pattern": "REDIS-[Purpose]-[Location]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/redis-workload",
      "defaultValue": "CACHE",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "library": "core/location",
      "defaultValue": "AZ",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["REDIS-CACHE-AZ-PROD", "REDIS-SESSION-AAD-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Purpose", "Location", "Environment"],
    "availableSegments": ["Purpose", "Location", "Environment", "Custom"],
    "recommendedSegments": ["Purpose"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{0,61}[A-Za-z0-9]$"
  }
}
