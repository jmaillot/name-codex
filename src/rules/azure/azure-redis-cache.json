{
  "id": "azure-redis-cache",
  "category": "Azure",
  "name": "Redis Cache",
  "description": "Azure Redis Cache naming per CAF (Microsoft Cloud Adoption Framework). The Redis cache instance provides in-memory data store for caching and session state. The name refers to the cache instance itself and must be globally unique where applicable.",
  "pattern": "redis-[Purpose]-[Region]-[Environment]",
  "fields": [
    {
      "name": "Purpose",
      "library": "azure/redis-workload",
      "defaultValue": "CACHE",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["redis-cache-frc-prod", "redis-session-we-dev"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Purpose", "Region", "Environment"],
    "availableSegments": ["Purpose", "Region", "Environment", "Custom"],
    "recommendedSegments": ["Purpose"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^(?!.*--)[a-z][a-z0-9-]{0,61}[a-z0-9]$"
  }
}
