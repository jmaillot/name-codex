{
  "id": "azure-resource-group",
  "category": "Azure",
  "name": "Resource Group",
  "description": "Azure resource group naming.",
  "pattern": "RG-[Region]-[Environment]-[Workload]",
  "fields": [
    {
      "name": "Region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "defaultValue": "AD",
      "allowedValues": ["AD", "VNET", "WEBAPP", "LOGS", "BACKUP", "ERP", "CRM"],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "RG-FRC-PROD-VNET"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Region","Environment","Workload"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": ["Region","Environment"],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$",
    "requireLockedSegments": true,
    "requireRecommendedSegments": false
  }
}
