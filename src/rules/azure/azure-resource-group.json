{
  "id": "azure-resource-group",
  "category": "Azure",
  "name": "Resource Group",
  "description": "Azure resource group naming.",
  "pattern": "RG-[Region]-[Environment]-[Workload]",
  "fields": [
    {
      "name": "Region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "defaultValue": "AD",
      "allowCustomValue": true,
      "values": [
        {
          "value": "AD",
          "description": "Active Directory"
        },
        {
          "value": "VNET",
          "description": "Virtual Network"
        },
        {
          "value": "WEBAPP",
          "description": "Web Application"
        },
        {
          "value": "LOGS",
          "description": "Logging"
        },
        {
          "value": "BACKUP",
          "description": "Backup"
        },
        {
          "value": "ERP",
          "description": "ERP"
        },
        {
          "value": "CRM",
          "description": "Customer Relationship Management"
        }
      ]
    }
  ],
  "examples": [
    "RG-FRC-PROD-VNET"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Region",
      "Environment",
      "Workload"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Workload"
    ],
    "lockedSegments": [
      "Region",
      "Environment"
    ],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  }
}
