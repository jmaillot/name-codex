{
  "id": "azure-service-bus",
  "category": "Azure",
  "name": "Service Bus",
  "description": "Azure Service Bus naming per CAF (Microsoft Cloud Adoption Framework — Microsoft's guidance collection for structuring and naming cloud resources): sb-[Workload]-[Environment]-[Region]-[Instance].",
  "pattern": "sb-[Workload]-[Environment]-[Region]-[Instance]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/sb-workload",
      "defaultValue": "ORDERS",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": ["sb-orders-prod-frc-001"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Environment", "Region", "Instance"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "forceLowercase": true,
    "allowedPattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
  }
}
