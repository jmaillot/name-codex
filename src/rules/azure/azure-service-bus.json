{
  "id": "azure-service-bus",
  "category": "Azure",
  "name": "Service Bus",
  "description": "Azure Service Bus naming per CAF (Microsoft Cloud Adoption Framework \u2014 Microsoft's guidance collection for structuring and naming cloud resources).",
  "pattern": "SBNS-[Workload]-[Environment]-[Region]-[Instance]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/sb-workload",
      "defaultValue": "ORDERS",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "patterns": [
    {
      "id": "namespace",
      "name": "Namespace (Standard)",
      "description": "Service Bus Standard namespace. Globally unique, 6\u201350 characters, lowercase letters, numbers and hyphens, must start with letter and end with letter or number, no consecutive hyphens. Used for messaging and integration.",
      "pattern": "SBNS-[Workload]-[Environment]-[Region]-[Instance]",
      "examples": [
        "SBNS-orders-prod-frc-001"
      ]
    },
    {
      "id": "queue",
      "name": "Queue",
      "description": "Service Bus Queue. Queue name identifies the message queue purpose within a namespace. 1\u2013260 characters, lowercase, hyphenated.",
      "pattern": "SBQ-[Purpose]",
      "fields": [
        {
          "name": "Purpose",
          "library": "azure/sb-queue-purpose",
          "defaultValue": "ORDERS",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "SBQ-orders"
      ]
    },
    {
      "id": "topic",
      "name": "Topic",
      "description": "Service Bus Topic. Topic name identifies the publish/subscribe topic purpose within a namespace. 1\u2013260 characters, lowercase, hyphenated.",
      "pattern": "SBT-[Purpose]",
      "fields": [
        {
          "name": "Purpose",
          "library": "azure/sb-topic-purpose",
          "defaultValue": "ORDEREVENTS",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "SBT-orderevents"
      ]
    },
    {
      "id": "subscription",
      "name": "Subscription",
      "description": "Service Bus Subscription. Subscription name identifies the consumer of a topic within a subscription. 1\u201350 characters, lowercase, hyphenated.",
      "pattern": "SBTS-[Consumer]",
      "fields": [
        {
          "name": "Consumer",
          "library": "azure/sb-subscription-consumer",
          "defaultValue": "CRM",
          "allowCustomValue": true
        }
      ],
      "examples": [
        "SBTS-crm"
      ]
    }
  ],
  "examples": [
    "SBNS-orders-prod-frc-001"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Environment",
      "Region",
      "Instance"
    ],
    "availableSegments": [
      "Workload",
      "Purpose",
      "Consumer",
      "Environment",
      "Region",
      "Instance",
      "Custom"
    ],
    "recommendedSegments": [
      "Workload",
      "Purpose",
      "Consumer"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 260,
    "forceLowercase": true,
    "allowedPattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
  }
}
