{
  "id": "azure-sql-database",
  "category": "Azure",
  "name": "SQL Database",
  "description": "Azure SQL Database naming per CAF. Database name 1\u2013128 characters, lowercase letters, numbers and hyphens.",
  "pattern": "sqldb-[Workload]-[Purpose]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/sql-db-workload",
      "defaultValue": "CRM",
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "library": "azure/sql-db-purpose",
      "defaultValue": "APP",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "sqldb-crm-app-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Purpose",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Workload",
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "forceLowercase": true,
    "allowedPattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
  }
}
