{
  "id": "azure-sql-server",
  "category": "Azure",
  "name": "SQL Server",
  "description": "Azure SQL Server naming per CAF (Microsoft Cloud Adoption Framework). Server name is globally unique, 1\u201363 characters, lowercase letters, numbers and hyphens, must start with letter and end with letter or number, no consecutive hyphens.",
  "pattern": "sqlsrv-[Workload]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/sql-workload",
      "defaultValue": "CRM",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "sqlsrv-crm-prod"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Workload"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 63,
    "forceLowercase": true,
    "allowedPattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
  }
}
