{
  "id": "azure-storage-account",
  "category": "Azure",
  "name": "Storage Account",
  "description": "Azure storage account naming per CAF (Microsoft Cloud Adoption Framework — Microsoft's guidance collection for structuring and naming cloud resources). The storage account name IS the public endpoint (e.g. stdataprodfrc001.blob.core.windows.net) and must be globally unique across all Azure tenants — uniqueness itself cannot be checked here. Lowercase letters and numbers only, no hyphens or underscores, 3–24 characters.",
  "pattern": "st[Workload][Environment][Region][Instance]",
  "fields": [
    {
      "name": "Workload",
      "type": "dropdown",
      "defaultValue": "DATA",
      "allowCustomValue": true,
      "allowedValues": [
        "BACKUP",
        "LOGS",
        "DATA",
        "MEDIA",
        "FILES",
        "ARCHIVE",
        "CONFIG",
        "APP",
        "SHARED",
        "TFSTATE"
      ]
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Region",
      "library": "core/region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": ["stdatafrcprod001"],
  "builder": {
    "separator": "",
    "defaultSegments": ["Workload", "Environment", "Region", "Instance"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": ["Workload"],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 24,
    "forceLowercase": true,
    "removeCharacters": ["-", "_", "."],
    "allowedPattern": "^[a-z0-9][a-z0-9]{1,22}[a-z0-9]$"
  }
}
