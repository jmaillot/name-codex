{
  "id": "azure-synapse-workspace",
  "category": "Azure",
  "name": "Synapse Workspace",
  "description": "Azure Synapse Analytics workspace naming per CAF (Microsoft Cloud Adoption Framework). The workspace provides unified analytics for Spark and SQL pools over data lake and warehouse. The name refers to the workspace itself and its analytics pools scope and should be globally unique where applicable.",
  "pattern": "synw-[Workload]-[Location]-[Environment]",
  "fields": [
    {
      "name": "Workload",
      "library": "azure/synw-workload",
      "defaultValue": "DATA",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "library": "core/location",
      "defaultValue": "AZ",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": ["synw-DATA-AZ-PROD", "synw-ANALYTICS-AAD-DEV"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Workload", "Location", "Environment"],
    "availableSegments": ["Workload", "Location", "Environment", "Custom"],
    "recommendedSegments": ["Workload"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 50,
    "allowedPattern": "^(?!.*--)[A-Za-z][A-Za-z0-9-]{0,48}[A-Za-z0-9]$"
  }
}
