{
  "id": "azure-virtual-machine",
  "category": "Azure",
  "name": "Virtual Machine",
  "description": "Azure Virtual Machine naming per CAF. Virtual machine name 1\u201315 characters (Windows) or 1\u201364 characters (Linux), alphanumeric and hyphens, cannot contain only numbers, cannot end with period or hyphen.",
  "pattern": "[Country][Location][OS][Role][Instance]",
  "fields": [
    {
      "name": "Country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "defaultValue": "AZ",
      "values": [
        {
          "value": "AZ",
          "description": "Azure"
        }
      ]
    },
    {
      "name": "OS",
      "library": "core/operating-system",
      "defaultValue": "W",
      "allowCustomValue": true
    },
    {
      "name": "Role",
      "library": "core/role",
      "defaultValue": "DC",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "label": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "FRAZWADP001"
  ],
  "validation": {
    "maxLength": 64,
    "allowedPattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,62}[A-Za-z0-9]$|^[A-Za-z0-9]$"
  },
  "builder": {
    "separator": "",
    "defaultSegments": [
      "Country",
      "Location",
      "OS",
      "Role",
      "Instance"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [],
    "lockedSegments": [
      "Role"
    ],
    "fixedFirstSegments": [
      "Country",
      "Location",
      "OS"
    ],
    "fixedLastSegments": [
      "Instance"
    ]
  }
}
