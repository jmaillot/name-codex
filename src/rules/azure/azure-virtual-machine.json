{
  "id": "azure-virtual-machine",
  "category": "Azure",
  "name": "Virtual Machine",
  "description": "Azure virtual machine naming.",
  "pattern": "[Country][Location][OS][Role][Instance]",
  "fields": [
    {
      "name": "Country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "Location",
      "defaultValue": "AZ",
      "values": [
        {
          "value": "AZ",
          "description": "Azure"
        }
      ]
    },
    {
      "name": "OS",
      "defaultValue": "W",
      "allowCustomValue": true
    },
    {
      "name": "Role",
      "defaultValue": "AD",
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "label": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "FRAZWADP001"
  ],
  "builder": {
    "separator": "",
    "defaultSegments": [
      "Country",
      "Location",
      "OS",
      "Role",
      "Instance"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [],
    "lockedSegments": [
      "Role"
    ],
    "fixedFirstSegments": [
      "Country",
      "Location",
      "OS"
    ],
    "fixedLastSegments": [
      "Instance"
    ]
  }
}
