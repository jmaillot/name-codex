{
  "id": "azure-virtual-network-gateway-ip",
  "category": "Azure",
  "name": "Virtual Network Gateway IP Address",
  "description": "Azure Virtual Network Gateway IP Address naming.",
  "pattern": "[Region]-[Country]-[Workload]-[Instance]-[Role]-[IP]",
  "fields": [
    {
      "name": "Region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "label": "Workload",
      "defaultValue": "VNET",
      "allowedValues": [
        "VNET"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "label": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowedValues": [
        "001",
        "002",
        "003"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Role",
      "defaultValue": "GW"
    },
    {
      "name": "IP",
      "defaultValue": "IP"
    }
  ],
  "examples": [
    "FRC-FR-VNET-001-GW-IP"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Region",
      "Country",
      "Workload",
      "Instance",
      "Role",
      "IP"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Country",
      "Instance"
    ],
    "lockedSegments": [
      "Workload"
    ],
    "fixedFirstSegments": [
      "Region"
    ],
    "fixedLastSegments": [
      "Role",
      "IP"
    ]
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
