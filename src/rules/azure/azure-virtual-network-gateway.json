{
  "id": "azure-virtual-network-gateway",
  "category": "Azure",
  "name": "Virtual Network Gateway",
  "description": "Azure Virtual Network Gateway naming.",
  "pattern": "[Region]-[Country]-[Workload]-[Instance]-[Role]",
  "fields": [
    {
      "name": "Region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "label": "Workload",
      "defaultValue": "VNET",
      "allowCustomValue": false,
      "values": [
        {
          "value": "VNET",
          "description": "Virtual Network"
        }
      ]
    },
    {
      "name": "Instance",
      "label": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    },
    {
      "name": "Role",
      "defaultValue": "GW",
      "allowCustomValue": false,
      "values": [
        {
          "value": "GW",
          "description": "Gateway"
        }
      ]
    }
  ],
  "patterns": [
    {
      "id": "gateway",
      "name": "Gateway",
      "description": "Virtual Network Gateway.",
      "pattern": "[Region]-[Country]-[Workload]-[Instance]-[Role]",
      "examples": ["FRC-FR-VNET-001-GW"]
    },
    {
      "id": "gateway-ip",
      "name": "Gateway IP",
      "description": "Virtual Network Gateway IP address.",
      "pattern": "[Region]-[Country]-[Workload]-[Instance]-[Role]-[IP]",
      "fields": [
        {
          "name": "IP",
          "defaultValue": "IP",
          "allowCustomValue": false,
          "values": [
            {
              "value": "IP",
              "description": "IP Address"
            }
          ]
        }
      ],
      "examples": ["FRC-FR-VNET-001-GW-IP"]
    }
  ],
  "examples": ["FRC-FR-VNET-001-GW"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Region", "Country", "Workload", "Instance", "Role"],
    "availableSegments": ["Region", "Country", "Workload", "Instance", "Role", "IP", "Custom"],
    "recommendedSegments": ["Country", "Instance"],
    "lockedSegments": ["Workload"],
    "fixedFirstSegments": ["Region"],
    "fixedLastSegments": ["Role"]
  }
}
