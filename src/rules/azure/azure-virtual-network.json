{
  "id": "azure-virtual-network",
  "category": "Azure",
  "name": "Virtual Network",
  "description": "Azure Virtual Network naming per CAF. Virtual network name 2\u201364 characters, alphanumeric, hyphens, underscores and periods, cannot start or end with underscore, cannot contain consecutive special characters.",
  "pattern": "[Region]-[Country]-[Workload]-[Instance]",
  "fields": [
    {
      "name": "Region",
      "defaultValue": "FRC",
      "allowCustomValue": true
    },
    {
      "name": "Country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "defaultValue": "VNET",
      "allowCustomValue": false,
      "values": [
        {
          "value": "VNET",
          "description": "Virtual Network"
        }
      ]
    },
    {
      "name": "Instance",
      "label": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "FRC-FR-VNET-001"
  ],
  "validation": {
    "maxLength": 64,
    "allowedPattern": "^[A-Za-z0-9_.-]{2,64}$"
  },
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Region",
      "Country",
      "Workload",
      "Instance"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Country",
      "Workload"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Region"
    ],
    "fixedLastSegments": [
      "Instance"
    ]
  }
}
