{
  "id": "azure-virtual-subnets",
  "category": "Azure",
  "name": "Virtual Subnets",
  "description": "Azure Subnet naming.",
  "pattern": "[Country]-[Environment]-[Workload]-[Instance]",
  "fields": [
    {
      "name": "Country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Workload",
      "defaultValue": "Subnet",
      "allowedValues": [
        "Subnet"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Instance",
      "label": "Instance",
      "library": "core/instance",
      "defaultValue": "001",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "FR-PROD-SUBNET-001"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Country",
      "Environment",
      "Workload",
      "Instance"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Environment",
      "Workload"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Country"
    ],
    "fixedLastSegments": [
      "Instance"
    ]
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
