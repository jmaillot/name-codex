{
  "id": "ca-extended-policy",
  "category": "Conditional Access",
  "name": "Conditional Access Policy - Extended",
  "description": "Use for full context policies. Includes Platform and Version segments not available in the Microsoft Recommended pattern. Recommended when platform-specific targeting or change tracking is required.",
  "pattern": "[PolicyId]-[Persona]-[Applications]-[Platforms]-[Conditions]-[Controls]",
  "fields": [
    {
      "name": "PolicyId",
      "label": "PolicyId",
      "type": "text",
      "generator": "ca-policy-id",
      "customOnly": true,
      "placeholder": "",
      "examples": [
        "Select the persona, then fill CAx + number, e.g. CA1 + 01 = CA101"
      ],
      "defaultValue": ""
    },
    {
      "name": "Persona",
      "label": "Persona",
      "library": "conditional-access/ca-persona",
      "defaultValue": "",
      "allowCustomValue": true,
      "examples": [
        "Select the persona, then fill CAx + number, e.g. CA1 + 01 = CA101"
      ]
    },
    {
      "name": "Applications",
      "label": "Application",
      "library": "conditional-access/ca-apps",
      "defaultValue": "AllApps",
      "allowCustomValue": true,
      "examples": [
        "Fill out the scoped App used by this policy, ex: AzureManagementPortal"
      ]
    },
    {
      "name": "Platforms",
      "label": "Platforms",
      "library": "conditional-access/ca-platforms",
      "multiSelect": true,
      "multiAllValue": "AllPlatforms",
      "defaultValue": "AllPlatforms"
    },
    {
      "name": "Conditions",
      "label": "Condition/When",
      "library": "conditional-access/ca-conditions",
      "defaultValue": "",
      "allowCustomValue": true,
      "multiSelect": true,
      "multiExclusions": [
        [
          "TrustedDevice",
          "NonTrustedDevice"
        ],
        [
          "TrustedLocation",
          "NonTrustedLocation"
        ]
      ],
      "examples": [
        "Select one or put a custom condition"
      ]
    },
    {
      "name": "Controls",
      "label": "Controls",
      "library": "conditional-access/ca-controls",
      "defaultValue": "MFA",
      "multiSelect": true,
      "multiExclusions": [
        [
          "MFA",
          "MFASTRENGH"
        ]
      ],
      "multiAllValue": "Block"
    }
  ],
  "examples": [
    "CA201-EMPLOYEES-ALLAPPS-ALLPLATFORMS-EXTERNAL-MFA-PROD"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "PolicyId",
      "Persona",
      "Applications",
      "Platforms",
      "Conditions",
      "Controls"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "PolicyId",
      "Persona",
      "Applications",
      "Platforms",
      "Conditions",
      "Controls"
    ],
    "fixedLastSegments": []
  }
}
