{
  "id": "defender-m365-policy",
  "category": "Defender for M365",
  "name": "Defender for M365 - Other Policies Type",
  "description": "Protects against impersonation, spoofing, and phishing attacks targeting your recipients.",
  "pattern": "DEF-[DefPolicyType]-[ScopeType]-[Descriptor]-[Environment]-[Version]",
  "fields": [
    {
      "name": "DefPolicyType",
      "label": "PolicyType",
      "library": "defender/def-policytype",
      "defaultValue": "AntiPhish",
      "allowedValues": [
        "AntiPhish",
        "AntiMalware",
        "SafeAttachments",
        "SafeLinks"
      ],
      "allowCustomValue": true
    },
    {
      "name": "ScopeType",
      "label": "Scope",
      "library": "intune/assignments",
      "defaultValue": "AllUsers",
      "allowedValues": [
        "AllUsers"
      ],
      "examples": [
        "AllUsers",
        "GroupName"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Descriptor",
      "examples": [
        "Strict",
        "Baseline",
        "HighRisk"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Version",
      "defaultValue": "V1",
      "allowCustomValue": true,
      "values": [
        {
          "value": "V1",
          "description": "Version 1"
        }
      ]
    }
  ],
  "examples": [
    "DEF-ANTIPHISH-ALLUSERS-STRICT-PROD-V1"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "DefPolicyType",
      "ScopeType",
      "Descriptor",
      "Environment",
      "Version"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Environment",
      "Version"
    ],
    "lockedSegments": [
      "Descriptor"
    ],
    "fixedFirstSegments": [
      "DefPolicyType",
      "ScopeType"
    ],
    "fixedLastSegments": []
  }
}
