{
  "id": "defender-quarantine-policy",
  "category": "Defender for M365",
  "name": "Defender Quarantine Policy",
  "description": "Defender Quarantine policy naming per governance. Policy controls end-user access and notification behavior for quarantined messages, with consistent naming for security operations and user communication.",
  "pattern": "QUARANTINE-[QuarantineScope]-[AccessLevel]-[Notify]",
  "fields": [
    {
      "name": "QuarantineScope",
      "label": "Scope",
      "examples": [
        "Company",
        "Finance",
        "IT"
      ],
      "allowCustomValue": true
    },
    {
      "name": "AccessLevel",
      "label": "AccessLevel",
      "library": "defender/def-accesslevel",
      "defaultValue": "FullAccess",
      "allowCustomValue": false
    },
    {
      "name": "Notify",
      "label": "Notify",
      "library": "defender/def-notification",
      "defaultValue": "WithNotification",
      "allowedValues": [
        "WithNotification",
        ""
      ],
      "allowCustomValue": false
    }
  ],
  "examples": [
    "QUARANTINE-IT-FULLACCESS-WITHNOTIFICATION"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "QuarantineScope",
      "AccessLevel",
      "Notify"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "QuarantineScope",
      "AccessLevel",
      "Notify"
    ],
    "fixedLastSegments": []
  }
}
