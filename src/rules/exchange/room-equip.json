{
  "id": "exchange-room-equip",
  "category": "Exchange",
  "name": "Room Mailbox / Equipment Mailbox",
  "description": "Resource mailbox for bookable rooms or equipment, integrated with Outlook calendar scheduling.",
  "pattern": "[MailboxType]-[Department]-[City]-[Floor]-[Name]",

  "fields": [
    {
      "name": "MailboxType",
      "defaultValue": "Room"
    },
    {
      "name": "Department",
      "label": "Department",
      "type": "dropdown",
      "values": [
        ""
      ],
      "defaultValue": "",
      "examples": ["HR", "IT", "FIN", "OPS"],
      "allowCustomValue": true
    },
    {
      "name": "City",
      "label": "City",
      "type": "dropdown",
      "values": [
        ""
      ],
      "defaultValue": "",
      "examples": ["Lille", "Paris"],
      "allowCustomValue": true
    },
    {
      "name": "Floor",
      "label": "Floor",
      "type": "dropdown",
      "values": [
        ""
      ],
      "defaultValue": "",
      "examples": ["1st Floor"],
      "allowCustomValue": true
    },
    {
      "name": "Name",
      "label": "Name / Number",
      "type": "dropdown",
      "values": [
        ""
      ],
      "defaultValue": "",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "ROOM-HR-LILLE-1RSTFLOOR-MEETINGROOM01"
  ],
  "builder": { 
    "separator": "-",
    "defaultSegments": ["MailboxType","Department","City","Floor","Name"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Department","City","Floor"],
    "lockedSegments": [],
    "fixedFirstSegments": ["MailboxType"],
    "fixedLastSegments": ["Name"]
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$",
    "requireLockedSegments": true,
    "requireRecommendedSegments": false
  }
}
