{
  "id": "exchange-room-equip",
  "category": "Exchange",
  "name": "Room Mailbox / Equipment Mailbox",
  "description": "Resource mailbox for bookable rooms or equipment, integrated with Outlook calendar scheduling.",
  "pattern": "[MailboxType]-[Department]-[City]-[Floor]-[Name]",
  "fields": [
    {
      "name": "MailboxType",
      "defaultValue": "Room",
      "allowedValues": [
        "Room",
        "Equip"
      ]
    },
    {
      "name": "Department",
      "label": "Department",
      "type": "dropdown",
      "defaultValue": "",
      "examples": [
        "HR",
        "IT",
        "FIN",
        "OPS"
      ],
      "allowCustomValue": true
    },
    {
      "name": "City",
      "label": "City",
      "defaultValue": "",
      "examples": [
        "Lille",
        "Paris"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Floor",
      "label": "Floor",
      "defaultValue": "",
      "examples": [
        "1st Floor"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Name",
      "label": "Name / Number",
      "type": "dropdown",
      "values": [
        {
          "value": "001",
          "description": "Default"
        },
        {
          "value": "002",
          "description": ""
        },
        {
          "value": "003",
          "description": ""
        }
      ],
      "defaultValue": "001"
    }
  ],
  "examples": [
    "ROOM-HR-LILLE-1RSTFLOOR-MEETINGROOM01"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "MailboxType",
      "Department",
      "City",
      "Floor",
      "Name"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Department",
      "City",
      "Floor"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "MailboxType"
    ],
    "fixedLastSegments": [
      "Name"
    ]
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
