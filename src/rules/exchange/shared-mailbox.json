{
  "id": "exchange-shared-mailbox",
  "category": "Exchange",
  "name": "Shared Mailbox",
  "description": "Exchange Shared Mailbox naming per governance. Shared mailbox accessible by multiple users for monitoring and sending from a common email address, with consistent naming for ownership and purpose.",
  "pattern": "[MailboxType]-[Department]-[Function]-[City]",
  "fields": [
    {
      "name": "MailboxType",
      "library": "exchange/mailbox-type",
      "defaultValue": "SHARED",
      "allowedValues": [
        "SHARED",
        "SMB"
      ]
    },
    {
      "name": "Department",
      "label": "Department",
      "type": "dropdown",
      "defaultValue": "",
      "examples": [
        "HR",
        "IT",
        "FIN",
        "OPS"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Function",
      "label": "Function",
      "type": "dropdown",
      "defaultValue": "",
      "examples": [
        "Alerts",
        "Info"
      ],
      "allowCustomValue": true,
      "values": [
        {
          "value": "Alerts",
          "description": "Alert notifications"
        },
        {
          "value": "Info",
          "description": "Informational"
        },
        {
          "value": "Backup",
          "description": "Backup"
        },
        {
          "value": "Reporting",
          "description": "Reporting"
        },
        {
          "value": "Invoices",
          "description": "Invoice processing"
        }
      ]
    },
    {
      "name": "City",
      "label": "City",
      "defaultValue": "",
      "examples": [
        "Lille",
        "Paris"
      ],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "SHARED-HR-RECRUITMENT-LILLE"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "MailboxType",
      "Department",
      "Function",
      "City"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "City"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "MailboxType",
      "Department",
      "Function"
    ],
    "fixedLastSegments": []
  }
}
