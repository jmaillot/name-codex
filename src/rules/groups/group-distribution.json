{
  "id": "exchange-distribution-group",
  "category": "Groups",
  "name": "Distribution Group",
  "description": "Distribution list for sending email to a defined set of recipients, optionally scoped to internal-only or external senders.",
  "pattern": "[Location]-[Prefix]-[Scope]-[Department]-[Purpose]",
  "fields": [
    {
      "name": "Location",
      "defaultValue": "AAD",
      "allowedValues": [
        "AAD"
      ]
    },
    {
      "name": "Prefix",
      "label": "Prefix",
      "library": "groups/prefix",
      "defaultValue": "DL",
      "allowedValues": [
        "DL",
        "DYNDL"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Scope",
      "label": "Scope",
      "defaultValue": "Internal",
      "allowedValues": [
        "Internal",
        "External"
      ]
    },
    {
      "name": "Department",
      "defaultValue": "",
      "examples": [
        "HR",
        "IT",
        "FIN",
        "OPS"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "defaultValue": "",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "AAD-DL-INTERNAL-IT-ALERTS"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Location",
      "Prefix",
      "Scope",
      "Department",
      "Purpose"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Department",
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Location",
      "Prefix",
      "Scope"
    ],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
