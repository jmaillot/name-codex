{
  "id": "exchange-distribution-group",
  "category": "Groups",
  "name": "Distribution Group",
  "description": "Distribution List naming per governance. Distribution list for sending email to a defined set of recipients, optionally scoped to internal or external senders, with consistent prefix, scope and department taxonomy for mail flow management.",
  "pattern": "[Location]-[Prefix]-[Scope]-[Department]-[Purpose]",
  "fields": [
    {
      "name": "Location",
      "defaultValue": "AAD",
      "values": [
        {
          "value": "AAD",
          "description": "Entra ID"
        }
      ]
    },
    {
      "name": "Prefix",
      "label": "Prefix",
      "library": "groups/prefix",
      "defaultValue": "DL",
      "allowedValues": [
        "DL",
        "DYNDL"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Scope",
      "label": "Scope",
      "defaultValue": "Internal",
      "values": [
        {
          "value": "Internal",
          "description": "Internal"
        },
        {
          "value": "External",
          "description": "External"
        }
      ]
    },
    {
      "name": "Department",
      "defaultValue": "",
      "examples": [
        "HR",
        "IT",
        "FIN",
        "OPS"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "defaultValue": "",
      "examples": [
        "Alerts",
        "Invoices"
      ],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "AAD-DL-INTERNAL-IT-ALERTS"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Location",
      "Prefix",
      "Scope",
      "Department",
      "Purpose"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Department",
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Location",
      "Prefix",
      "Scope"
    ],
    "fixedLastSegments": []
  }
}
