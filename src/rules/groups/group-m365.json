{
  "id": "groups-m365",
  "category": "Groups",
  "name": "Microsoft 365 Group",
  "description": "Microsoft 365 Group with a shared mailbox, calendar, and collaboration space across Microsoft 365 services. Supports optional role-assignable or dynamic user membership and a sensitivity label.",
  "pattern": "[Prefix]-[MembershipTypeM365]-[Department]-[Purpose]-[Sensitivity]-[Environment]",
  "fields": [
    {
      "name": "Prefix",
      "label": "Prefix",
      "library": "groups/prefix",
      "defaultValue": "M365",
      "allowedValues": [
        "M365",
        "O365",
        "TEAM"
      ],
      "allowCustomValue": true
    },
    {
      "name": "MembershipTypeM365",
      "library": "groups/membership-type",
      "defaultValue": "ASS",
      "allowedValues": [
        "ASS",
        "RA",
        "DYNU"
      ]
    },
    {
      "name": "Department",
      "defaultValue": "",
      "examples": [
        "HR",
        "IT",
        "FIN",
        "OPS"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "defaultValue": "",
      "examples": [
        "Alerts",
        "Invoices"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Sensitivity",
      "defaultValue": "PRIVATE",
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "M365-DYNU-IT-PRIVATE-PROD"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Prefix",
      "MembershipTypeM365",
      "Department",
      "Purpose",
      "Sensitivity",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Department"
    ],
    "lockedSegments": [
      "Purpose"
    ],
    "fixedFirstSegments": [
      "Prefix",
      "MembershipTypeM365"
    ],
    "fixedLastSegments": []
  }
}
