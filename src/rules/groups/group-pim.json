{
  "id": "groups-pim",
  "category": "Groups",
  "name": "PIM / JIT Group",
  "description": "Privileged Identity Management group for just-in-time access to privileged roles and resources.",
  "pattern": "[Prefix]-[PimRoles]-[Scope]-[AccessType]-[Environment]",
  "fields": [
    {
      "name": "Prefix",
      "label": "Prefix",
      "library": "groups/prefix",
      "defaultValue": "PIM",
      "allowedValues": [
        "PIM",
        "JIT"
      ],
      "allowCustomValue": true
    },
    {
      "name": "PimRoles",
      "library": "groups/roles-pim",
      "defaultValue": "GlobalAdmin",
      "allowCustomValue": true
    },
    {
      "name": "Scope",
      "label": "Scope",
      "defaultValue": "Tier1",
      "allowedValues": [
        "Tier1",
        "Partner",
        "Audit"
      ],
      "allowCustomValue": true
    },
    {
      "name": "AccessType",
      "label": "AccessType",
      "defaultValue": "Eligible",
      "allowedValues": [
        "Eligible",
        "Active"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "PIM-GLOBALADMIN-TIER1-ELIGIBLE-PROD"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Prefix",
      "PimRoles",
      "Scope",
      "AccessType",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Environment"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Prefix",
      "PimRoles",
      "Scope",
      "AccessType"
    ],
    "fixedLastSegments": []
  }
}
