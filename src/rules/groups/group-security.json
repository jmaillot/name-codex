{
  "id": "group-security",
  "category": "Groups",
  "name": "Security Group",
  "description": "General-purpose security group for access control, policy assignment, or resource scoping. Supports optional role-assignable or dynamic user/device membership.",
  "pattern": "[Location]-[Prefix]-[MembershipType]-[Department]-[Purpose]-[Scope]-[Environment]",
  "fields": [
    {
      "name": "Location",
      "defaultValue": "AAD",
      "allowedValues": ["AAD"]
    },
    {
      "name": "Prefix",
      "label": "Prefix",
      "library": "groups/prefix",
      "defaultValue": "GSEC",
      "allowedValues": ["GSEC"]
    },
    {
      "name": "MembershipType",
      "defaultValue": ""
    },
    {
      "name": "Department",
      "defaultValue": "",
      "examples": ["HR", "IT", "FIN", "OPS"],
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "defaultValue": "",
      "examples": ["ADM", "LIC", "AppAccess"],
      "allowCustomValue": true
    },
    {
      "name": "Scope",
      "defaultValue": "",
      "examples": ["AllUsers", "IT", "Guests"],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "AAD-GSEC-DYNU-APPACCESS-GUESTS"
  ],
  "builder": { 
    "separator": "-",
    "defaultSegments": ["Location","Prefix","MembershipType","Department","Purpose","Scope","Environment"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["MembershipType","Scope"],
    "lockedSegments": ["Purpose"],
    "fixedFirstSegments": ["Location","Prefix"],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$",
    "requireLockedSegments": true,
    "requireRecommendedSegments": false
  }
}
