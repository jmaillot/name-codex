{
  "id": "group-security",
  "category": "Groups",
  "name": "Security Group",
  "description": "General-purpose security group for access control, policy assignment, or resource scoping. Supports optional role-assignable or dynamic user/device membership.",
  "pattern": "AAD-GSEC-[MembershipType]-[Department]-[Purpose]-[Scope]-[Environment]",
  "fields": [
    {
      "name": "MembershipType",
      "library": "groups/membership-type",
      "defaultValue": "ASS"
    },
    {
      "name": "Department",
      "defaultValue": "",
      "examples": [
        "HR",
        "IT",
        "FIN",
        "OPS"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Purpose",
      "defaultValue": "",
      "examples": [
        "ADM",
        "LIC",
        "AppAccess"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Scope",
      "defaultValue": "",
      "examples": [
        "AllUsers",
        "IT",
        "Guests"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "AAD-GSEC-DYNU-APPACCESS-GUESTS"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "MembershipType",
      "Department",
      "Purpose",
      "Scope",
      "Environment"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "MembershipType",
      "Scope"
    ],
    "lockedSegments": [
      "Purpose"
    ],
    "fixedFirstSegments": [
      "MembershipType"
    ],
    "fixedLastSegments": []
  }
}
