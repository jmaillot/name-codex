{
  "id": "intune-app-configuration",
  "category": "Intune",
  "name": "Application Configuration Policy",
  "description": "App configuration policy that pre-configures settings inside a managed app for enrolled devices or managed apps: ACP-<scope>-<enrollment type>-<platform>-<application>-<descriptor>.",
  "pattern": "ACP-[Scope]-[EnrollmentType]-[Platform]-[Application]-[Descriptor]",
  "fields": [
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "CORP",
      "allowCustomValue": false,
      "values": [
        {
          "value": "CORP",
          "description": "Corporate"
        },
        {
          "value": "BYOD",
          "description": "Bring Your Own Device"
        }
      ]
    },
    {
      "name": "EnrollmentType",
      "type": "dropdown",
      "defaultValue": "ManagedDevices",
      "allowCustomValue": false,
      "values": [
        {
          "value": "ManagedDevices",
          "description": "Managed devices"
        },
        {
          "value": "ManagedApps",
          "description": "Managed apps"
        }
      ]
    },
    {
      "name": "Platform",
      "type": "dropdown",
      "defaultValue": "IOS",
      "allowCustomValue": false,
      "values": [
        {
          "value": "IOS",
          "description": "iOS"
        },
        {
          "value": "AND",
          "description": "Android"
        },
        {
          "value": "WIN",
          "description": "Windows"
        }
      ]
    },
    {
      "name": "Application",
      "type": "dropdown",
      "defaultValue": "OUTLOOK",
      "allowCustomValue": true,
      "values": [
        {
          "value": "OUTLOOK",
          "description": "Outlook"
        },
        {
          "value": "TEAMS",
          "description": "Teams"
        },
        {
          "value": "EDGE",
          "description": "Edge"
        },
        {
          "value": "ONEDRIVE",
          "description": "OneDrive"
        },
        {
          "value": "M365",
          "description": "Microsoft 365"
        },
        {
          "value": "EXCEL",
          "description": "Excel"
        },
        {
          "value": "WORD",
          "description": "Word"
        },
        {
          "value": "POWERPOINT",
          "description": "PowerPoint"
        }
      ]
    },
    {
      "name": "Descriptor",
      "type": "text",
      "examples": [
        "OutlookFocusedInbox",
        "TeamsConfig",
        "VPNSettings"
      ],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "ACP-CORP-MANAGEDDEVICES-IOS-OUTLOOK-FOCUSEDINBOX"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Scope",
      "EnrollmentType",
      "Platform",
      "Application",
      "Descriptor"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Descriptor"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
