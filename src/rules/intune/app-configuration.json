{
  "id": "intune-app-configuration",
  "category": "Intune",
  "name": "Application Configuration Policy",
  "description": "App configuration policy that pre-configures settings inside a managed app for enrolled devices or managed apps: ACP-<scope>-<enrollment type>-<platform>-<application>-<descriptor>.",
  "pattern": "ACP-[Scope]-[EnrollmentType]-[Platform]-[Application]-[Descriptor]",
  "fields": [
    {
      "name": "IntPrefix",
      "label": "Prefix",
      "library": "intune/intune-prefix",
      "defaultValue": "ACP",
      "allowedValues": [
        "ACP"
      ]
    },
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "CORP",
      "allowCustomValue": false,
      "allowedValues": [
        "CORP",
        "BYOD"
      ]
    },
    {
      "name": "EnrollmentType",
      "type": "dropdown",
      "defaultValue": "ManagedDevices",
      "allowedValues": [
        "ManagedDevices",
        "ManagedApps"
      ],
      "allowCustomValue": false
    },
    {
      "name": "Platform",
      "type": "dropdown",
      "defaultValue": "IOS",
      "allowCustomValue": false,
      "allowedValues": [
        "IOS",
        "AND",
        "WIN"
      ]
    },
    {
      "name": "Application",
      "type": "dropdown",
      "defaultValue": "OUTLOOK",
      "allowCustomValue": true,
      "allowedValues": [
        "OUTLOOK",
        "TEAMS",
        "EDGE",
        "ONEDRIVE",
        "M365",
        "EXCEL",
        "WORD",
        "POWERPOINT"
      ]
    },
    {
      "name": "Descriptor",
      "type": "text",
      "examples": [
        "OutlookFocusedInbox",
        "TeamsConfig",
        "VPNSettings"
      ],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "ACP-CORP-ManagedDevices-IOS-OUTLOOK-FocusedInbox"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Scope",
      "EnrollmentType",
      "Platform",
      "Application",
      "Descriptor"
    ],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Descriptor"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
