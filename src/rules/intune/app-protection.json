{
  "id": "intune-app-protection",
  "category": "Intune",
  "name": "Application Protection Policy",
  "description": "App protection policy that protects organizational data within managed apps, independent of device enrollment.",
  "pattern": "[IntPrefix]-[ScopeTag]-[CA-Platforms]-[Assignments]-[Descriptor]-[Environment]-[Version]",
  "fields": [
    {
      "name": "IntPrefix",
      "label": "Prefix",
      "library": "intune/intune-prefix",
      "defaultValue": "MAM",
      "allowedValues": ["MAM"]
    },
    {
      "name": "ScopeTag",
      "defaultValue": "",
      "examples": ["Global", "EMEA", "FR","HR","IT"],
      "allowCustomValue": true
    },
    {
      "name": "CA-Platforms",
      "label": "Plaform",
      "defaultValue": "W"
    },
    {
      "name": "Assignments",
      "library": "intune/assignments",
      "defaultValue": "BYODUsers",
      "allowedValues": ["BYODUsers", "ExternalContractors"],
      "examples": ["FrontlineUsers"],
      "allowCustomValue": true
    },
    {
      "name": "Descriptor",
      "examples": ["DataProtectionoutlook", "BlockCopyPaste","BlockDownload"],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Version",
      "type": "text",
      "defaultValue": "V1"
    }
  ],
  "examples": [
    "MAM-W-BYODUSERS-BLOCKCOPYPASTE-PROD-V1"
  ],
  "builder": { 
    "separator": "-",
    "defaultSegments": ["IntPrefix","ScopeTag","CA-Platforms","Assignments","Descriptor","Environment","Version"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["CA-Platforms","Environment","Version"],
    "lockedSegments": ["Assignments","Descriptor"],
    "fixedFirstSegments": ["IntPrefix","ScopeTag"],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$",
    "requireLockedSegments": true,
    "requireRecommendedSegments": false
  }
}

