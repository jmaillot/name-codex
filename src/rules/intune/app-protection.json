{
  "id": "intune-app-protection",
  "category": "Intune",
  "name": "Application Protection Policy",
  "description": "App protection policy (MAM) that protects organizational data within managed apps, independent of device enrollment: MAM-<scope>-<platform>-<target>-<purpose>.",
  "pattern": "MAM-[Scope]-[Platform]-[Target]-[Purpose]",
  "fields": [
    {
      "name": "IntPrefix",
      "label": "Prefix",
      "library": "intune/intune-prefix",
      "defaultValue": "MAM",
      "allowedValues": [
        "MAM"
      ]
    },
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "CORP",
      "allowCustomValue": false,
      "allowedValues": [
        "CORP",
        "BYOD"
      ]
    },
    {
      "name": "Platform",
      "type": "dropdown",
      "defaultValue": "IOS",
      "allowCustomValue": false,
      "allowedValues": [
        "IOS",
        "AND",
        "WIN"
      ]
    },
    {
      "name": "Target",
      "type": "dropdown",
      "defaultValue": "M365",
      "allowCustomValue": true,
      "allowedValues": [
        "M365",
        "OUTLOOK",
        "TEAMS",
        "ONEDRIVE",
        "EDGE",
        "ALLAPPS"
      ]
    },
    {
      "name": "Purpose",
      "type": "text",
      "examples": [
        "DataProtectionoutlook",
        "BlockCopyPaste",
        "BlockDownload",
        "Baseline"
      ],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "MAM-CORP-IOS-OUTLOOK-DataProtection"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Scope",
      "Platform",
      "Target",
      "Purpose"
    ],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["Purpose"],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
