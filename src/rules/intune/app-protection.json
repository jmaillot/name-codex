{
  "id": "intune-app-protection",
  "category": "Intune",
  "name": "Application Protection Policy",
  "description": "Intune App Protection policy (MAM) naming per governance. Policy protects organizational data within managed apps independent of device enrollment, with consistent naming for platform, scope and data protection level.",
  "pattern": "MAM-[Scope]-[Platform]-[Target]-[Purpose]",
  "fields": [
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "CORP",
      "allowCustomValue": false,
      "values": [
        {
          "value": "CORP",
          "description": "Corporate"
        },
        {
          "value": "BYOD",
          "description": "Bring Your Own Device"
        }
      ]
    },
    {
      "name": "Platform",
      "type": "dropdown",
      "defaultValue": "IOS",
      "allowCustomValue": false,
      "values": [
        {
          "value": "IOS",
          "description": "iOS"
        },
        {
          "value": "AND",
          "description": "Android"
        },
        {
          "value": "WIN",
          "description": "Windows"
        }
      ]
    },
    {
      "name": "Target",
      "type": "dropdown",
      "defaultValue": "M365",
      "allowCustomValue": true,
      "values": [
        {
          "value": "M365",
          "description": "Microsoft 365"
        },
        {
          "value": "OUTLOOK",
          "description": "Outlook"
        },
        {
          "value": "TEAMS",
          "description": "Teams"
        },
        {
          "value": "ONEDRIVE",
          "description": "OneDrive"
        },
        {
          "value": "EDGE",
          "description": "Edge"
        },
        {
          "value": "ALLAPPS",
          "description": "All apps"
        }
      ]
    },
    {
      "name": "Purpose",
      "type": "text",
      "examples": [
        "DataProtectionoutlook",
        "BlockCopyPaste",
        "BlockDownload",
        "Baseline"
      ],
      "allowCustomValue": true
    }
  ],
  "examples": [
    "MAM-CORP-IOS-OUTLOOK-DataProtection"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Scope",
      "Platform",
      "Target",
      "Purpose"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  }
}
