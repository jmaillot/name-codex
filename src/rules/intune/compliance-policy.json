{
  "id": "intune-compliance-policy",
  "category": "Intune",
  "name": "Compliance Policy",
  "description": "Device compliance policy that evaluates whether a device meets your organization's security requirements.",
  "pattern": "[IntPrefix]-[ScopeTag]-[OS]-[Assignments]-[Descriptor]-[Environment]-[Version]",
  "fields": [
    {
      "name": "IntPrefix",
      "label": "Prefix",
      "library": "intune/intune-prefix",
      "defaultValue": "CMP",
      "allowedValues": ["CMP"]
    },
    {
      "name": "ScopeTag",
      "defaultValue": "",
      "examples": ["Global", "EMEA", "FR","HR","IT"],
      "allowCustomValue": true
    },
    {
      "name": "OS",
      "defaultValue": "W"
    },
    {
      "name": "Assignments",
      "library": "intune/assignments",
      "defaultValue": "AllUsers",
      "allowedValues": ["AllUsers", "AllDevices"],
      "examples": ["GroupName"],
      "allowCustomValue": true
    },
    {
      "name": "Descriptor",
      "examples": ["BitLockerAndPasswordPolicy", "NonComplianceActions", "BaselineSecurityRules"],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Version"
    }
  ],
  "examples": [
    "CMP-GLOBAL-W-ALLUSERS-BASELINESECURITYRULES-PROD-V1"
  ],
  "builder": { 
    "separator": "-",
    "defaultSegments": ["IntPrefix","ScopeTag","OS","Assignments","Descriptor","Environment","Version"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["OS","Environment","Version"],
    "lockedSegments": ["Assignments","Descriptor"],
    "fixedFirstSegments": ["IntPrefix","ScopeTag"],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$",
    "requireLockedSegments": true,
    "requireRecommendedSegments": false
  }
}

