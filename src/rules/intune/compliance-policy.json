{
  "id": "intune-compliance-policy",
  "category": "Intune",
  "name": "Compliance Policy",
  "description": "Device compliance policy that evaluates whether a device meets your organization's security requirements.",
  "pattern": "CMP-[ScopeTag]-[OS]-[Assignments]-[Descriptor]-[Environment]-[Version]",
  "fields": [
    {
      "name": "ScopeTag",
      "defaultValue": "",
      "examples": [
        "Global",
        "EMEA",
        "FR",
        "HR",
        "IT"
      ],
      "allowCustomValue": true
    },
    {
      "name": "OS",
      "library": "core/operating-system",
      "defaultValue": "W",
      "allowCustomValue": true
    },
    {
      "name": "Assignments",
      "library": "intune/assignments",
      "defaultValue": "AllUsers",
      "allowedValues": [
        "AllUsers",
        "AllDevices"
      ],
      "examples": [
        "GroupName"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Descriptor",
      "examples": [
        "BitLockerAndPasswordPolicy",
        "NonComplianceActions",
        "BaselineSecurityRules"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Version",
      "defaultValue": "V1",
      "allowCustomValue": true,
      "values": [
        {
          "value": "V1",
          "description": "Version 1"
        }
      ]
    }
  ],
  "examples": [
    "CMP-GLOBAL-W-ALLUSERS-BASELINESECURITYRULES-PROD-V1"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "ScopeTag",
      "OS",
      "Assignments",
      "Descriptor",
      "Environment",
      "Version"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "OS",
      "Environment",
      "Version"
    ],
    "lockedSegments": [
      "Assignments",
      "Descriptor"
    ],
    "fixedFirstSegments": [
      "ScopeTag"
    ],
    "fixedLastSegments": []
  }
}
