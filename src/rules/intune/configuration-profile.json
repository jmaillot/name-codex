{
  "id": "intune-configuration-profile",
  "category": "Intune",
  "name": "Configuration Profile",
  "description": "Configuration profile that pushes settings to enrolled devices, such as Wi-Fi, VPN, email, or endpoint protection. Can also cover Intune scripts and remediation scripts.",
  "pattern": "CFG-[ScopeTag]-[OS]-[Assignments]-[Descriptor]-[Environment]-[Version]",
  "fields": [
    {
      "name": "ScopeTag",
      "defaultValue": "",
      "examples": [
        "Global",
        "EMEA",
        "FR",
        "HR",
        "IT"
      ],
      "allowCustomValue": true
    },
    {
      "name": "OS",
      "library": "core/operating-system",
      "defaultValue": "W",
      "allowCustomValue": true
    },
    {
      "name": "Assignments",
      "library": "intune/assignments",
      "defaultValue": "AllUsers",
      "allowedValues": [
        "AllUsers",
        "AllDevices"
      ],
      "examples": [
        "GroupName"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Descriptor",
      "examples": [
        "WifiCorp",
        "VPN",
        "Bitlocker"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Version",
      "defaultValue": "V1",
      "allowCustomValue": true,
      "values": [
        {
          "value": "V1",
          "description": "Version 1"
        }
      ]
    }
  ],
  "examples": [
    "CFG-GLOBAL-W-VPNUSERS-VPN-PROD-V1"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "ScopeTag",
      "OS",
      "Assignments",
      "Descriptor",
      "Environment",
      "Version"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "OS",
      "Environment",
      "Version"
    ],
    "lockedSegments": [
      "Assignments",
      "Descriptor"
    ],
    "fixedFirstSegments": [
      "ScopeTag"
    ],
    "fixedLastSegments": []
  }
}
