{
  "id": "endpoint-security-policy",
  "category": "Intune",
  "name": "Endpoint Security Policy",
  "description": "Endpoint security policies for devices, covering antivirus, firewall, attack surface reduction, and endpoint detection and response.",
  "pattern": "[PolicyId]-[ScopeTag]-[OS]-[IntProfileType]-[Assignments]-[Descriptor]-[Environment]-[Version]",
  "fields": [
    {
      "name": "PolicyId",
      "label": "Policy",
      "type": "text",
      "generator": "devsec-policy-id",
      "customOnly": true,
      "placeholder": "",
      "examples": [
        "DEVSEC is fixed. Add the number, e.g. DEVSEC + 001 = DEVSEC001"
      ],
      "defaultValue": "DEVSEC001"
    },
    {
      "name": "ScopeTag",
      "label": "ScopeTag",
      "defaultValue": "",
      "allowCustomValue": true
    },
    {
      "name": "OS",
      "defaultValue": "W",
      "allowedValues": [
        "W",
        "MAC",
        "L"
      ]
    },
    {
      "name": "IntProfileType",
      "label": "ProfileType",
      "defaultValue": "Antivirus",
      "allowCustomValue": true,
      "allowedValuesByField": {
        "OS": {
          "L": [
            "Antivirus",
            "AntivirusExclusions",
            "EDR"
          ],
          "MAC": [
            "Antivirus",
            "AntivirusExclusions",
            "EDR"
          ]
        }
      }
    },
    {
      "name": "Assignments",
      "library": "intune/assignments",
      "defaultValue": "AllUsers",
      "allowedValues": [
        "AllUsers",
        "AllDevices"
      ],
      "examples": [
        "GroupName"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Descriptor",
      "examples": [
        "AttackSurfaceReduction",
        "DefenderBaseline",
        "FirewallRules"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Environment",
      "defaultValue": "PROD",
      "allowCustomValue": true
    },
    {
      "name": "Version"
    }
  ],
  "examples": [
    "DEVSEC001-GLOBAL-W-ASR-ALLUSERS-BASELINE-PROD-V1"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "PolicyId",
      "ScopeTag",
      "OS",
      "IntProfileType",
      "Assignments",
      "Descriptor",
      "Environment",
      "Version"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Environment",
      "Version"
    ],
    "lockedSegments": [
      "Descriptor"
    ],
    "fixedFirstSegments": [
      "PolicyId",
      "ScopeTag",
      "OS",
      "IntProfileType",
      "Assignments"
    ],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Za-z0-9_.-]+$"
  }
}
