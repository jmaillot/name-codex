{
  "id": "intune-assignment-group",
  "category": "Intune",
  "name": "Assignment Group",
  "description": "Entra assignment-group name for Intune deployments using the INTUNE-{DEV|USR}-<name> taxonomy.",
  "pattern": "[GroupPrefix]-[GroupName]",
  "fields": [
    {
      "name": "GroupPrefix",
      "library": "intune/assignment-group-prefix",
      "defaultValue": "INTUNE-DEV",
      "allowCustomValue": false
    },
    {
      "name": "GroupName",
      "type": "text",
      "defaultValue": "",
      "examples": ["Laptops", "Phones"],
      "allowCustomValue": true,
      "allowedPattern": "^[A-Za-z0-9-]+$"
    }
  ],
  "examples": ["INTUNE-DEV-Laptops"],
  "builder": {
    "separator": "-",
    "defaultSegments": ["GroupPrefix", "GroupName"],
    "availableSegments": ["Custom"],
    "recommendedSegments": ["GroupName"],
    "lockedSegments": [],
    "fixedFirstSegments": ["GroupPrefix"],
    "fixedLastSegments": []
  },
  "validation": { "maxLength": 128, "allowedPattern": "^[A-Za-z0-9_.-]+$" }
}
