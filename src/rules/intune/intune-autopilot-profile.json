{
  "id": "intune-autopilot-profile",
  "category": "Intune",
  "name": "Autopilot Profile",
  "description": "Windows Autopilot deployment profile naming: APT-<country>-<device type>-<purpose>.",
  "pattern": "APT-[Country]-[DeviceType]-[Purpose]",
  "fields": [
    {
      "name": "Country",
      "library": "core/country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "DeviceType",
      "type": "dropdown",
      "defaultValue": "LAPTOP",
      "allowCustomValue": true,
      "library": "intune/autopilot-devicetype"
    },
    {
      "name": "Purpose",
      "type": "dropdown",
      "defaultValue": "STANDARD",
      "allowCustomValue": true,
      "library": "intune/autopilot-purpose-profile"
    }
  ],
  "examples": [
    "APT-FR-LAPTOP-STANDARD"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Country",
      "DeviceType",
      "Purpose"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Country"
    ],
    "fixedLastSegments": []
  }
}
