{
  "id": "intune-group-tag",
  "category": "Intune",
  "name": "Autopilot Group Tag",
  "description": "Autopilot Group Tag: drives dynamic group membership and per-group Autopilot profile assignment: AGT-<country>-<device type>-<purpose>.",
  "pattern": "AGT-[Country]-[DeviceType]-[Purpose]",
  "fields": [
    {
      "name": "Country",
      "library": "core/country",
      "defaultValue": "FR",
      "allowCustomValue": true
    },
    {
      "name": "DeviceType",
      "type": "dropdown",
      "defaultValue": "LAPTOP",
      "allowCustomValue": true,
      "library": "intune/autopilot-devicetype"
    },
    {
      "name": "Purpose",
      "type": "dropdown",
      "defaultValue": "STANDARD",
      "allowCustomValue": true,
      "library": "intune/autopilot-purpose",
      "allowedValues": [
        "STANDARD",
        "VIP",
        "DEVELOPER",
        "PILOT"
      ]
    }
  ],
  "examples": [
    "AGT-FR-LAPTOP-STANDARD"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Country",
      "DeviceType",
      "Purpose"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Purpose"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Country"
    ],
    "fixedLastSegments": []
  }
}
