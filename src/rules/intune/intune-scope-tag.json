{
  "id": "intune-scope-tag",
  "category": "Intune",
  "name": "Scope Tag",
  "description": "Intune Scope Tag naming per governance. Scope tag for scoping administrative access to devices and policies, for role-based access control.",
  "pattern": "ST-[Country]-[Department]-[Service]",
  "fields": [
    {
      "name": "Country",
      "type": "dropdown",
      "defaultValue": "FR",
      "allowCustomValue": true,
      "library": "intune/scopetag-country"
    },
    {
      "name": "Department",
      "library": "core/department",
      "defaultValue": "IT",
      "allowCustomValue": true
    },
    {
      "name": "Service",
      "type": "dropdown",
      "defaultValue": "SUPPORT",
      "allowCustomValue": true,
      "library": "intune/scopetag-service"
    }
  ],
  "examples": [
    "ST-FR-IT-SUPPORT"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Country",
      "Department",
      "Service"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [
      "Service"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Country"
    ],
    "fixedLastSegments": []
  }
}
