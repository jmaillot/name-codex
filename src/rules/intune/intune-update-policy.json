{
  "id": "intune-update-policy",
  "category": "Intune",
  "name": "Update Policy",
  "description": "Intune Update Policy naming (replaces the classic Update Ring taxonomy): UPD-<platform>-<stage>, with a dedicated Windows sub-type UPD-WIN-<stage>-<purpose> covering Quality/Feature/Driver/Hotpatch updates.",
  "pattern": "UPD-[Platform]-[Stage]",
  "patterns": [
    {
      "id": "platform-stage",
      "name": "Platform + Stage",
      "description": "Generic platforms: UPD-<platform>-<stage> (e.g. UPD-IOS-PRODUCTION)",
      "pattern": "UPD-[Platform]-[Stage]",
      "defaultSegments": [
        "Platform",
        "Stage"
      ],
      "fields": [
        {
          "name": "Platform",
          "type": "dropdown",
          "defaultValue": "IOS",
          "allowCustomValue": false,
          "library": "intune/updatepolicy-platform",
          "tip": "Windows has its own sub-type: pick the 'Windows + Stage + Purpose' variant when naming Windows Update Policies."
        },
        {
          "name": "Stage",
          "type": "dropdown",
          "defaultValue": "PRODUCTION",
          "allowCustomValue": true,
          "library": "intune/updatepolicy-stage"
        }
      ],
      "examples": [
        "UPD-IOS-PRODUCTION"
      ]
    },
    {
      "id": "win-stage-purpose",
      "name": "Windows + Stage + Purpose",
      "description": "Windows only: UPD-WIN-<stage>-<purpose> where purpose is QUALITY, FEATURE, DRIVER or HOTPATCH",
      "pattern": "UPD-WIN-[Stage]-[Purpose]",
      "defaultSegments": [
        "Stage",
        "Purpose"
      ],
      "fields": [
        {
          "name": "Stage",
          "type": "dropdown",
          "defaultValue": "PRODUCTION",
          "allowCustomValue": true,
          "library": "intune/updatepolicy-stage"
        },
        {
          "name": "Purpose",
          "type": "dropdown",
          "defaultValue": "QUALITY",
          "allowCustomValue": false,
          "library": "intune/updatepolicy-win-purpose"
        }
      ],
      "examples": [
        "UPD-WIN-PILOT-FEATURE"
      ]
    }
  ],
  "fields": [
    {
      "name": "Platform",
      "type": "dropdown",
      "defaultValue": "IOS",
      "allowCustomValue": false,
      "library": "intune/updatepolicy-platform"
    },
    {
      "name": "Stage",
      "type": "dropdown",
      "defaultValue": "PRODUCTION",
      "allowCustomValue": true,
      "library": "intune/updatepolicy-stage"
    }
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Platform",
      "Stage"
    ],
    "availableSegments": [
      "Custom"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  }
}
