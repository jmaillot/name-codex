{
  "id": "pp-connection",
  "category": "Power Platform",
  "name": "Connection",
  "description": "Power Platform connection and connection reference governance for Dataverse, SharePoint Online, Exchange Online, Teams and other connectors with shared purpose taxonomy for consistent integration lifecycle and environment-aware deployment.",
  "pattern": "PPC-[Connector]-[Purpose]",
  "fields": [
    {
      "name": "Connector",
      "type": "dropdown",
      "defaultValue": "DATAVERSE",
      "allowCustomValue": true,
      "values": [
        { "value": "DATAVERSE", "description": "Microsoft Dataverse connector" },
        { "value": "SPO", "description": "SharePoint Online connector" },
        { "value": "EXO", "description": "Exchange Online connector" },
        { "value": "TEAMS", "description": "Microsoft Teams connector" },
        { "value": "SQL", "description": "SQL Server connector" },
        { "value": "GRAPH", "description": "Microsoft Graph connector" },
        { "value": "HTTP", "description": "HTTP connector" },
        { "value": "SAP", "description": "SAP connector" },
        { "value": "D365", "description": "Dynamics 365 connector" },
        { "value": "SERVICENOW", "description": "ServiceNow connector" },
        { "value": "SALESFORCE", "description": "Salesforce connector" },
        { "value": "CUSTOMAPI", "description": "Custom API connector" }
      ]
    },
    {
      "name": "Purpose",
      "type": "dropdown",
      "defaultValue": "SHARED",
      "allowCustomValue": true,
      "values": [
        { "value": "SHARED", "description": "Shared connection for broad reuse" },
        { "value": "AUTOMATION", "description": "Process automation" },
        { "value": "APPROVALS", "description": "Approval workflows" },
        { "value": "HELPDESK", "description": "Helpdesk and support" },
        { "value": "HR", "description": "Human Resources" },
        { "value": "FINANCE", "description": "Finance" },
        { "value": "CRM", "description": "Customer Relationship Management" },
        { "value": "ERP", "description": "Enterprise Resource Planning" },
        { "value": "COPILOT", "description": "Copilot and AI workloads" },
        { "value": "INTEGRATION", "description": "System integration" }
      ]
    }
  ],
  "examples": [
    "PPC-DATAVERSE-SHARED",
    "PPC-SPO-INTEGRATION",
    "PPC-SQL-AUTOMATION"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Connector", "Purpose"],
    "availableSegments": ["Environment", "Custom"],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": ["Connector"],
    "fixedLastSegments": []
  },
  "validation": {
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper",
    "maxLength": 64
  }
}
