{
  "id": "pp-environment",
  "category": "Power Platform",
  "name": "Power Platform Environment",
  "description": "Power Platform environment naming per governance. Maintain at minimum Dev/Test/Prod. When creating an environment, choose its type explicitly (Sandbox vs Production). Rename the default environment to a descriptive name.",
  "pattern": "PPE-[Workload]-[Environment]",
  "patterns": [
    {
      "id": "environment",
      "name": "Environment",
      "description": "Typed environment for a specific workload and environment.",
      "pattern": "PPE-[Workload]-[Environment]",
      "defaultSegments": [
        "Workload",
        "Environment"
      ],
      "examples": [
        "PPE-HR-PROD"
      ]
    },
    {
      "id": "developer",
      "name": "Developer",
      "description": "Personal developer environment for an individual user.",
      "pattern": "PPE-DEV-[User]",
      "defaultSegments": [
        "User"
      ],
      "fields": [
        {
          "name": "User",
          "type": "text",
          "examples": [
            "JDOE"
          ],
          "allowCustomValue": true
        }
      ],
      "examples": [
        "PPE-DEV-JDOE"
      ]
    },
    {
      "id": "shared",
      "name": "Shared",
      "description": "Shared environment for a workload and environment, for collaborative scenarios.",
      "pattern": "PPE-SHARED-[Workload]-[Environment]",
      "defaultSegments": [
        "Workload",
        "Environment"
      ],
      "fields": [
        {
          "name": "Environment",
          "defaultValue": "UAT"
        }
      ],
      "examples": [
        "PPE-SHARED-CRM-UAT"
      ]
    }
  ],
  "fields": [
    {
      "name": "Workload",
      "type": "dropdown",
      "defaultValue": "POWERAPPS",
      "allowCustomValue": true,
      "library": "power-platform/pp-workload"
    },
    {
      "name": "Environment",
      "library": "core/environment",
      "defaultValue": "DEV",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "PPE-HR-PROD",
    "PPE-DEV-JDOE",
    "PPE-SHARED-CRM-UAT"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Environment"
    ],
    "availableSegments": [],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  }
}
