{
  "id": "pp-solution",
  "category": "Power Platform",
  "name": "Solution",
  "description": "Power Platform solution governance for domain-aligned solution packaging with business solution taxonomy for consistent application lifecycle management and environment-aware deployment.",
  "pattern": "PPS-[Domain]-[Solution]",
  "fields": [
    {
      "name": "Domain",
      "type": "dropdown",
      "defaultValue": "CORP",
      "allowCustomValue": true,
      "values": [
        { "value": "HR", "description": "Human Resources" },
        { "value": "FINANCE", "description": "Finance" },
        { "value": "CRM", "description": "Customer Relationship Management" },
        { "value": "SALES", "description": "Sales" },
        { "value": "IT", "description": "Information Technology" },
        { "value": "SECURITY", "description": "Security" },
        { "value": "LEGAL", "description": "Legal" },
        { "value": "PROCUREMENT", "description": "Procurement" },
        { "value": "OPERATIONS", "description": "Operations" },
        { "value": "CORP", "description": "Corporate" }
      ]
    },
    {
      "name": "Solution",
      "type": "dropdown",
      "defaultValue": "ONBOARDING",
      "allowCustomValue": true,
      "values": [
        { "value": "ONBOARDING", "description": "Employee onboarding" },
        { "value": "LEAVE", "description": "Leave management" },
        { "value": "TIMESHEET", "description": "Timesheet tracking" },
        { "value": "TRAINING", "description": "Training and learning" },
        { "value": "EXPENSES", "description": "Expense management" },
        { "value": "INVOICE", "description": "Invoice processing" },
        { "value": "BUDGET", "description": "Budget management" },
        { "value": "HELPDESK", "description": "IT helpdesk" },
        { "value": "ASSETMGMT", "description": "Asset management" },
        { "value": "SERVICEDESK", "description": "Service desk" },
        { "value": "CUSTOMERS", "description": "Customer management" },
        { "value": "OPPORTUNITIES", "description": "Sales opportunities" },
        { "value": "APPROVALS", "description": "Approval workflows" },
        { "value": "VISITORS", "description": "Visitor management" }
      ]
    }
  ],
  "examples": [
    "PPS-HR-ONBOARDING",
    "PPS-FINANCE-INVOICE",
    "PPS-CRM-OPPORTUNITIES"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": ["Domain", "Solution"],
    "availableSegments": ["Environment", "Custom"],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": ["Domain"],
    "fixedLastSegments": []
  },
  "validation": {
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper",
    "maxLength": 64
  }
}
