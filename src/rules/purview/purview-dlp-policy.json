{
  "id": "purview-dlp-policy",
  "category": "Purview",
  "name": "DLP Policy",
  "description": "Microsoft Purview data loss prevention policy. The name is renamable, BUT old names persist forever in audit and alert records — choose audit-friendly names from the start.",
  "pattern": "DLP-[DataType]-[Scope]-[Action]",
  "fields": [
    {
      "name": "DataType",
      "type": "dropdown",
      "defaultValue": "PII",
      "allowCustomValue": true,
      "allowedValues": [
        "PII",
        "PCI",
        "PHI",
        "FINANCIAL",
        "HR",
        "LEGAL",
        "GDPR",
        "CONFIDENTIAL",
        "SECRET",
        "CUSTOM"
      ]
    },
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "ALL",
      "allowCustomValue": true,
      "allowedValues": [
        "ALL",
        "EXO",
        "SPO",
        "OD",
        "TEAMS",
        "ENDPOINT",
        "CUSTOM"
      ]
    },
    {
      "name": "Action",
      "type": "dropdown",
      "defaultValue": "AUDIT",
      "allowCustomValue": true,
      "allowedValues": [
        "AUDIT",
        "WARN",
        "BLOCK",
        "BLOCKOVERRIDE",
        "CUSTOM"
      ]
    }
  ],
  "examples": [
    "DLP-PII-ALL-AUDIT"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "DataType",
      "Scope",
      "Action"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
