{
  "id": "purview-dlp-policy",
  "category": "Purview",
  "name": "DLP Policy",
  "description": "Microsoft Purview data loss prevention policy. The name is renamable, BUT old names persist forever in audit and alert records — choose audit-friendly names from the start.",
  "pattern": "DLP-[DataType]-[Scope]-[Action]",
  "fields": [
    {
      "name": "DataType",
      "type": "dropdown",
      "defaultValue": "PII",
      "allowCustomValue": true,
      "values": [
        {
          "value": "PII",
          "description": "Personally Identifiable Information"
        },
        {
          "value": "PCI",
          "description": "Payment Card Industry data"
        },
        {
          "value": "PHI",
          "description": "Protected Health Information"
        },
        {
          "value": "FINANCIAL",
          "description": "Financial data"
        },
        {
          "value": "HR",
          "description": "Human Resources data"
        },
        {
          "value": "LEGAL",
          "description": "Legal data"
        },
        {
          "value": "GDPR",
          "description": "GDPR-regulated data"
        },
        {
          "value": "CONFIDENTIAL",
          "description": "Confidential business data"
        },
        {
          "value": "SECRET",
          "description": "Highly confidential / secret"
        }
      ]
    },
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "ALL",
      "allowCustomValue": true,
      "values": [
        {
          "value": "ALL",
          "description": "All locations"
        },
        {
          "value": "EXO",
          "description": "Exchange Online"
        },
        {
          "value": "SPO",
          "description": "SharePoint Online"
        },
        {
          "value": "OD",
          "description": "OneDrive for Business"
        },
        {
          "value": "TEAMS",
          "description": "Microsoft Teams"
        },
        {
          "value": "ENDPOINT",
          "description": "Endpoint devices"
        }
      ]
    },
    {
      "name": "Action",
      "type": "dropdown",
      "defaultValue": "AUDIT",
      "allowCustomValue": true,
      "values": [
        {
          "value": "AUDIT",
          "description": "Audit only"
        },
        {
          "value": "WARN",
          "description": "Warn with policy tip"
        },
        {
          "value": "BLOCK",
          "description": "Block action"
        },
        {
          "value": "BLOCKOVERRIDE",
          "description": "Block with override"
        }
      ]
    }
  ],
  "examples": [
    "DLP-PII-ALL-AUDIT"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "DataType",
      "Scope",
      "Action"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
