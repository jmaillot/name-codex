{
  "id": "purview-retention-label",
  "category": "Purview",
  "name": "Retention Label",
  "description": "Microsoft Purview retention label. The name CANNOT be changed after save — validate the name carefully before creating it.",
  "pattern": "RET-[Category]-[Retention]-[Disposition]",
  "fields": [
    {
      "name": "Category",
      "type": "dropdown",
      "defaultValue": "GENERAL",
      "allowCustomValue": true,
      "allowedValues": [
        "GENERAL",
        "HR",
        "FINANCE",
        "LEGAL",
        "CONTRACT",
        "PROJECT",
        "EMAIL",
        "INVOICE",
        "RECORD",
        "CUSTOM"
      ]
    },
    {
      "name": "Retention",
      "type": "dropdown",
      "defaultValue": "7Y",
      "allowCustomValue": true,
      "allowedValues": [
        "1Y",
        "3Y",
        "5Y",
        "7Y",
        "10Y",
        "15Y",
        "25Y",
        "PERMANENT",
        "CUSTOM"
      ]
    },
    {
      "name": "Disposition",
      "type": "dropdown",
      "defaultValue": "REVIEW",
      "allowCustomValue": true,
      "allowedValues": [
        "DELETE",
        "REVIEW",
        "RECORD"
      ]
    }
  ],
  "examples": [
    "RET-GENERAL-7Y-REVIEW"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Category",
      "Retention",
      "Disposition"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
