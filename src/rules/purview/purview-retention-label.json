{
  "id": "purview-retention-label",
  "category": "Purview",
  "name": "Retention Label",
  "description": "Microsoft Purview retention label. The name CANNOT be changed after save — validate the name carefully before creating it.",
  "pattern": "RET-[Category]-[Retention]-[Disposition]",
  "fields": [
    {
      "name": "Category",
      "type": "dropdown",
      "defaultValue": "GENERAL",
      "allowCustomValue": true,
      "values": [
        { "value": "GENERAL", "description": "General retention" },
        { "value": "HR", "description": "Human Resources" },
        { "value": "FINANCE", "description": "Finance" },
        { "value": "LEGAL", "description": "Legal" },
        { "value": "CONTRACT", "description": "Contracts" },
        { "value": "PROJECT", "description": "Projects" },
        { "value": "EMAIL", "description": "Email messages" },
        { "value": "INVOICE", "description": "Invoices" },
        { "value": "RECORD", "description": "Records management" },
        { "value": "CUSTOM", "description": "Custom category" }
      ]
    },
    {
      "name": "Retention",
      "type": "dropdown",
      "defaultValue": "7Y",
      "allowCustomValue": true,
      "values": [
        { "value": "1Y", "description": "1 year" },
        { "value": "3Y", "description": "3 years" },
        { "value": "5Y", "description": "5 years" },
        { "value": "7Y", "description": "7 years" },
        { "value": "10Y", "description": "10 years" },
        { "value": "15Y", "description": "15 years" },
        { "value": "25Y", "description": "25 years" },
        { "value": "PERMANENT", "description": "Permanent retention" },
        { "value": "CUSTOM", "description": "Custom retention" }
      ]
    },
    {
      "name": "Disposition",
      "type": "dropdown",
      "defaultValue": "REVIEW",
      "allowCustomValue": true,
      "values": [
        { "value": "DELETE", "description": "Delete after retention" },
        { "value": "REVIEW", "description": "Review before disposition" },
        { "value": "RECORD", "description": "Declare as record" }
      ]
    }
  ],
  "examples": [
    "RET-GENERAL-7Y-REVIEW"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Category",
      "Retention",
      "Disposition"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
