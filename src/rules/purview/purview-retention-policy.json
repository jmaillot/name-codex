{
  "id": "purview-retention-policy",
  "category": "Purview",
  "name": "Retention Policy",
  "description": "Microsoft Purview retention policy, applied org-wide or to selected locations. Policy names apply after up to a 7-day lead time and cannot be renamed casually — plan names before creation.",
  "pattern": "RTP-[Scope]-[Retention]-[Action]",
  "fields": [
    {
      "name": "Scope",
      "type": "dropdown",
      "defaultValue": "ALL",
      "allowCustomValue": false,
      "values": [
        { "value": "EXO", "description": "Exchange Online" },
        { "value": "SPO", "description": "SharePoint Online" },
        { "value": "OD", "description": "OneDrive for Business" },
        { "value": "TEAMS", "description": "Microsoft Teams" },
        { "value": "M365", "description": "Microsoft 365" },
        { "value": "ALL", "description": "All locations" }
      ]
    },
    {
      "name": "Retention",
      "type": "dropdown",
      "defaultValue": "1Y",
      "allowCustomValue": false,
      "values": [
        { "value": "30D", "description": "30 days" },
        { "value": "90D", "description": "90 days" },
        { "value": "180D", "description": "180 days" },
        { "value": "1Y", "description": "1 year" },
        { "value": "3Y", "description": "3 years" },
        { "value": "5Y", "description": "5 years" },
        { "value": "7Y", "description": "7 years" },
        { "value": "10Y", "description": "10 years" },
        { "value": "PERMANENT", "description": "Permanent retention" }
      ]
    },
    {
      "name": "Action",
      "type": "dropdown",
      "defaultValue": "DELETE",
      "allowCustomValue": false,
      "values": [
        { "value": "DELETE", "description": "Delete after retention" },
        { "value": "RETAIN", "description": "Retain" },
        { "value": "RETAINDELETE", "description": "Retain and then delete" }
      ]
    }
  ],
  "examples": [
    "RTP-ALL-1Y-DELETE"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Scope",
      "Retention",
      "Action"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
