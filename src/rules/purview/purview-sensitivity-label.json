{
  "id": "purview-sensitivity-label",
  "category": "Purview",
  "name": "Sensitivity Label",
  "description": "Microsoft Purview sensitivity label from the classification taxonomy, with optional category variant.",
  "pattern": "SL-[Classification]-[Category]",
  "fields": [
    {
      "name": "Classification",
      "type": "dropdown",
      "defaultValue": "INTERNAL",
      "allowCustomValue": false,
      "values": [
        { "value": "PUBLIC", "description": "Public data" },
        { "value": "INTERNAL", "description": "Internal use only" },
        { "value": "CONFIDENTIAL", "description": "Confidential" },
        { "value": "HIGHLYCONFIDENTIAL", "description": "Highly confidential" },
        { "value": "SECRET", "description": "Secret" },
        { "value": "TOPSECRET", "description": "Top secret" }
      ]
    },
    {
      "name": "Category",
      "type": "dropdown",
      "defaultValue": "",
      "allowCustomValue": false,
      "values": [
        { "value": "HR", "description": "Human Resources" },
        { "value": "FINANCE", "description": "Finance" },
        { "value": "LEGAL", "description": "Legal" },
        { "value": "BOARD", "description": "Board" },
        { "value": "MNA", "description": "Mergers and acquisitions" },
        { "value": "EXECUTIVE", "description": "Executive" },
        { "value": "PROJECT", "description": "Project" }
      ]
    }
  ],
  "examples": [
    "SL-CONFIDENTIAL",
    "SL-CONFIDENTIAL-HR"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Classification"
    ],
    "availableSegments": [
      "Category"
    ],
    "recommendedSegments": [
      "Category"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [
      "Classification"
    ],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
