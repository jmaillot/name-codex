{
  "id": "spo-communication-site",
  "category": "SharePoint",
  "name": "Communication Site",
  "description": "SharePoint Communication site provisioned at /sites/<url>. The title can be renamed later independently of the URL.",
  "pattern": "SPC-[Department]-[Purpose]",
  "fields": [
    {
      "name": "Department",
      "type": "dropdown",
      "defaultValue": "CORP",
      "allowCustomValue": true,
      "values": [
        {
          "value": "CORP",
          "description": "Corporate"
        },
        {
          "value": "HR",
          "description": "Human Resources"
        },
        {
          "value": "IT",
          "description": "Information Technology"
        },
        {
          "value": "FINANCE",
          "description": "Finance"
        },
        {
          "value": "LEGAL",
          "description": "Legal"
        },
        {
          "value": "SECURITY",
          "description": "Security"
        },
        {
          "value": "MARKETING",
          "description": "Marketing"
        },
        {
          "value": "OPERATIONS",
          "description": "Operations"
        }
      ]
    },
    {
      "name": "Purpose",
      "type": "dropdown",
      "defaultValue": "INTRANET",
      "allowCustomValue": true,
      "values": [
        {
          "value": "INTRANET",
          "description": "Intranet"
        },
        {
          "value": "PORTAL",
          "description": "Portal"
        },
        {
          "value": "NEWS",
          "description": "News"
        },
        {
          "value": "KNOWLEDGEBASE",
          "description": "Knowledge base"
        },
        {
          "value": "DOCUMENTATION",
          "description": "Documentation"
        },
        {
          "value": "AWARENESS",
          "description": "Awareness"
        },
        {
          "value": "SUPPORT",
          "description": "Support"
        }
      ]
    }
  ],
  "examples": [
    "SPC-CORP-INTRANET"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Department",
      "Purpose"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
