{
  "id": "spo-hub-site",
  "category": "SharePoint",
  "name": "Hub Site",
  "description": "SharePoint hub site. Microsoft recommends a consistent, discoverable naming convention for hub sites.",
  "pattern": "SPH-[Type]-[Domain]",
  "fields": [
    {
      "name": "Type",
      "type": "dropdown",
      "defaultValue": "DEPT",
      "allowCustomValue": true,
      "values": [
        { "value": "DEPT", "description": "Department" },
        { "value": "REG", "description": "Region" },
        { "value": "PRG", "description": "Program" },
        { "value": "COE", "description": "Center of Excellence" }
      ]
    },
    {
      "name": "Domain",
      "type": "dropdown",
      "defaultValue": "HR",
      "allowCustomValue": true,
      "values": [
        { "value": "HR", "description": "Human Resources" },
        { "value": "FINANCE", "description": "Finance" },
        { "value": "IT", "description": "Information Technology" },
        { "value": "LEGAL", "description": "Legal" },
        { "value": "SECURITY", "description": "Security" },
        { "value": "OPERATIONS", "description": "Operations" },
        { "value": "POWERPLATFORM", "description": "Power Platform" },
        { "value": "M365", "description": "Microsoft 365" },
        { "value": "AZURE", "description": "Azure" },
        { "value": "COPILOT", "description": "Copilot" },
        { "value": "DATA", "description": "Data" },
        { "value": "FR", "description": "France" },
        { "value": "EMEA", "description": "EMEA" },
        { "value": "EU", "description": "European Union" }
      ]
    }
  ],
  "examples": [
    "SPH-DEPT-HR"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Type",
      "Domain"
    ],
    "recommendedSegments": [],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 128,
    "allowedPattern": "^[A-Z0-9_.-]+$",
    "caseMode": "upper"
  }
}
