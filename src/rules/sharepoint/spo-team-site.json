{
  "id": "spo-team-site",
  "category": "SharePoint",
  "name": "Team Site (Group-Connected)",
  "description": "Group-connected SharePoint Team site provisioned at /teams/<url>. The site name becomes the M365 group display name and inherits the Entra group naming policy.",
  "pattern": "SPT-[Type]-[Name]",
  "fields": [
    {
      "name": "Type",
      "type": "dropdown",
      "defaultValue": "DEPT",
      "allowCustomValue": false,
      "values": [
        {
          "value": "DEPT",
          "description": "Department"
        },
        {
          "value": "PRJ",
          "description": "Project"
        },
        {
          "value": "CUS",
          "description": "Customer"
        },
        {
          "value": "APP",
          "description": "Application"
        },
        {
          "value": "COE",
          "description": "Center of Excellence"
        }
      ]
    },
    {
      "name": "Name",
      "allowCustomValue": true,
      "allowedValuesByField": {
        "Type": {
          "DEPT": [
            "HR",
            "FINANCE",
            "IT",
            "LEGAL",
            "MARKETING",
            "SALES",
            "OPERATIONS",
            "PURCHASING",
            "SECURITY"
          ],
