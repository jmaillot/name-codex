            "SERVICEPORTAL"
          ],
          "COE": [
            "M365",
            "POWERPLATFORM",
            "AZURE",
            "SECURITY",
            "DATA",
            "COPILOT"
          ],
          "CUS": []
        }
      },
      "values": [
        {
