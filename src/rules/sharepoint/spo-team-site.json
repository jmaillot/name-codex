          "description": "Human Resources"
        },
        {
          "value": "FINANCE",
          "description": "Finance"
        },
        {
          "value": "IT",
          "description": "Information Technology"
        },
        {
          "value": "LEGAL",
          "description": "Legal"
        },
        {
          "value": "MARKETING",
          "description": "Marketing"
        },
