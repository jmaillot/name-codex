{
  "id": "teams-department-team",
  "category": "Teams",
  "name": "Department Team",
  "description": "Microsoft Teams department team. Team name is the M365 group display name — keep it <=30 characters (the Teams client truncates around 30-36), use '-' or '_' after the prefix, spaces inside the name are allowed.",
  "pattern": "DEPT-[Workload]-[Function]",
  "fields": [
    {
      "name": "Workload",
      "type": "text",
      "defaultValue": "",
      "examples": [
        "Atlas",
        "Portal",
        "Migration"
      ],
      "allowCustomValue": true
    },
    {
      "name": "Function",
      "library": "core/function",
      "defaultValue": "",
      "allowCustomValue": true
    }
  ],
  "examples": [
    "DEPT-HR-Operations"
  ],
  "builder": {
    "separator": "-",
    "defaultSegments": [
      "Workload",
      "Function"
    ],
    "availableSegments": [],
    "recommendedSegments": [
      "Function"
    ],
    "lockedSegments": [],
    "fixedFirstSegments": [],
    "fixedLastSegments": []
  },
  "validation": {
    "maxLength": 30,
    "allowedPattern": "^[A-Za-z0-9 _-]+$",
    "caseMode": "preserve"
  }
}
